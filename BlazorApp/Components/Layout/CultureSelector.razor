@inject NavigationManager NavigationManager
@using System.Globalization

<div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        <i class="bi bi-globe"></i>
        <span>@CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToUpper()</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
        <li>
            <a class="dropdown-item @(CultureInfo.CurrentCulture.Name.StartsWith("ru", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@GetCultureUrl("ru")">
                Русский
            </a>
        </li>
        <li>
            <a class="dropdown-item @(CultureInfo.CurrentCulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@GetCultureUrl("en")">
                English
            </a>
        </li>
    </ul>
</div>

@code {
    private string GetCultureUrl(string cultureName)
    {
        var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var redirectUri = string.IsNullOrEmpty(currentUri) ? "/" : $"/{currentUri}";

        return $"/Culture/SetCulture?culture={cultureName}&redirectUri={Uri.EscapeDataString(redirectUri)}";
    }
}
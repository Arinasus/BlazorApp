@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using BlazorApp.Shared
@inject IStringLocalizer<MainLayout> L

<div class="main-wrapper">
    <NavMenu />
    <main>
        <article class="content-container animate__animated animate__fadeIn">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    @L["UnhandledError"]
    <a href="" class="reload">@L["Reload"]</a>
    <a class="dismiss">🗙</a>
</div>

<footer class="py-4 mt-auto border-top">
    <div class="container d-flex justify-content-between align-items-center">
        <span class="text-muted">© 2026 @L["BrandName"]</span>
        <ul class="nav">
            <li class="nav-item"><a href="support" class="nav-link px-2 text-muted">@L["NavSupport"]</a></li>
            <li class="nav-item"><a href="lectures" class="nav-link px-2 text-muted">@L["NavLectures"]</a></li>
            <li class="nav-item"><a href="therapists" class="nav-link px-2 text-muted">@L["NavTherapists"]</a></li>
        </ul>
    </div>
</footer>
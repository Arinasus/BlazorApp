@implements IDisposable
@inject NavigationManager NavigationManager
@using BlazorApp.Shared.Interfaces
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center fw-bold" href="">
            <img src="/images/logo.png" alt="Лого" class="nav-logo-img me-2" style="height: 40px; width: auto;" />
            <span>Речевик</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
                <li class="nav-item">
                    <NavLink class="nav-link" href="therapists">Специалисты</NavLink>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="contentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Обучение
                    </a>
                    <ul class="dropdown-menu border-0 shadow-sm">
                        <li><NavLink class="dropdown-item" href="lectures">Все лекции</NavLink></li>
                        <li><NavLink class="dropdown-item" href="recommended">Рекомендовано вам</NavLink></li>
                    </ul>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="chats">
                                <i class="bi bi-chat-left-text me-1"></i> Чаты
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

                @* АДМИН-ЦЕНТР *@
                <AuthorizeView Roles="Admin">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle manage-pill admin-pill d-inline-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shield-lock me-2"></i> <span>Admin-центр</span>
                        </a>
                        <ul class="dropdown-menu border-0 shadow-sm">
                            <li><NavLink class="dropdown-item" href="admin/dashboard">Панель управления</NavLink></li>
                            <li><NavLink class="dropdown-item" href="admin/applications">Заявки</NavLink></li>
                        </ul>
                    </li>
                </AuthorizeView>

                @* КНОПКИ ДЛЯ ЛОГОПЕДА (THERAPIST) *@
                <AuthorizeView Roles="Therapist">
                    <li class="nav-item d-flex gap-2">
                        <NavLink class="nav-link manage-pill therapist-pill d-inline-flex align-items-center" href="admin/lectures">
                            <i class="bi bi-journal-plus me-2"></i> <span>Добавить лекцию</span>
                        </NavLink>

                        <NavLink class="nav-link manage-pill therapist-pill d-inline-flex align-items-center ms-2" href="Account/Manage/TherapistDiary">
                            <i class="bi bi-journal-bookmark-fill me-2"></i> <span>Дневник занятий</span>
                        </NavLink>
                    </li>
                </AuthorizeView>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <CultureSelector />

                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-3">
                            <AuthorizeView Roles="Client" Context="parentContext">
                                <NavLink class="nav-link favorite-link d-flex align-items-center justify-content-center position-relative"
                                         href="parent/diary"
                                         title="Дневник ребенка">
                                    <i class="bi bi-person-heart"></i>
                                    @if (unreadInvitationsCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger animate-pulse"
                                              style="font-size: 0.65rem; padding: 0.35em 0.5em;">
                                            @unreadInvitationsCount
                                        </span>
                                    }
                                </NavLink>
                            </AuthorizeView>

                            <NavLink class="nav-link favorite-link d-flex align-items-center justify-content-center"
                                     href="Account/Manage/Favorites"
                                     title="Избранное">
                                <i class="bi bi-heart-fill"></i>
                            </NavLink>

                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle profile-btn rounded-pill px-3 shadow-sm d-inline-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-2"></i> <span>@context.User.Identity?.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                                    <li><NavLink class="dropdown-item" href="Account/Manage">Профиль</NavLink></li>

                                    <AuthorizeView Roles="Client" Context="parentMenuContext">
                                        <li><NavLink class="dropdown-item" href="parent/diary">Дневник ребенка</NavLink></li>
                                    </AuthorizeView>

                                    <AuthorizeView Roles="Therapist" Context="therapistMenuContext">
                                        <li><NavLink class="dropdown-item" href="Account/Manage/TherapistDiary">Дневник занятий</NavLink></li>
                                    </AuthorizeView>

                                    <li><NavLink class="dropdown-item" href="Account/Manage/Favorites">Избранное</NavLink></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form action="Account/Logout" method="post">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                            <button type="submit" class="dropdown-item text-danger">Выйти</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink class="btn btn-login" href="Account/Login">Вход</NavLink>
                        <NavLink class="btn btn-register ms-2" href="Account/Register">Регистрация</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

<style>
    .animate-pulse {
        animation: pulse-ring 2s infinite;
    }

    @("@keyframes") pulse-ring {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 5px rgba(220, 53, 69, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

@code {
    private string? currentUrl;
    private int unreadInvitationsCount = 0;
    private bool isAfterRender = false;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isAfterRender = true;
            await CheckInvitationsAsync();
            StateHasChanged();
        }
    }

    private async Task CheckInvitationsAsync()
    {
        if (!isAfterRender) return;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState?.User;

            if (userPrincipal?.Identity?.IsAuthenticated == true && userPrincipal.IsInRole("Client"))
            {
                var userEmail = userPrincipal.Identity.Name;

                if (!string.IsNullOrEmpty(userEmail))
                {
                    // Делаем изолированный сверхбыстрый запрос напрямую через фабрику контекста
                    using var context = await DbFactory.CreateDbContextAsync();

                    unreadInvitationsCount = await context.DiaryInvitations
                        .CountAsync(i => i.ParentEmail.ToLower() == userEmail.ToLower() && i.Status == "Pending");
                }
            }
            else
            {
                unreadInvitationsCount = 0;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Ошибка подсчета уведомлений: {ex.Message}");
            unreadInvitationsCount = 0;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
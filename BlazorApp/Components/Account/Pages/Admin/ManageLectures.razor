<style>
    .btn-outline-primary {
        color: #ff7f50;
        border-color: #ff7f50;
    }

        .btn-outline-primary:hover {
            background-color: #ff7f50;
            border-color: #ff7f50;
            color: white;
        }

    .form-control:focus, .form-select:focus {
        border-color: #ff7f50;
        box-shadow: 0 0 0 0.25rem rgba(255, 127, 80, 0.25); 
    }

    .btn-link:hover {
        opacity: 0.7;
        transform: scale(1.05);
        transition: all 0.2s;
    }

    .modal-backdrop {
        display: none !important;
        opacity: 0 !important;
    }
</style>

@code {
    private Lecture currentLecture = new() { ImagePath = "/images/default-lecture.png" };
    private List<Lecture>? displayedLectures;
    private HtmlTextEditor QuillHtml = default!;
    private List<Category> allCategories = new(); 
    private string newCategoryName = "";
    private Lecture? lectureToDelete;

    private bool isEditing = false;
    private string currentUserId = string.Empty;
    private bool isAdmin = false;
    private string? categoryErrorMessage;
    private LectureEditor lectureForm = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentUserId = user.Id;
            isAdmin = authState.User.IsInRole("Admin");
        }
        allCategories = await CategoryService.GetAllCategoriesAsync(); 
        await LoadLectures();
    }

    private async Task LoadLectures()
    {
        if (isAdmin)
        {
            displayedLectures = await LectureService.GetAllLecturesAsync();
        }
        else
        {
            displayedLectures = await LectureService.GetLecturesByAuthorAsync(currentUserId);
        }
    }
    private void HandleDeleteRequest(Lecture lecture)
    {
        lectureToDelete = lecture;
        JS.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show()");
    }

    private async Task ConfirmDelete()
    {
        if (lectureToDelete != null)
        {
            await LectureService.DeleteLectureAsync(lectureToDelete.Id);
            await JS.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('deleteConfirmModal')).hide()");
            lectureToDelete = null;
            await LoadLectures(); 
        }
    }
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);
            var folderPath = Path.Combine(WebHostEnvironment.WebRootPath, "uploads");

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            var filePath = Path.Combine(folderPath, fileName);
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var fileStream = new FileStream(filePath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            currentLecture.ImagePath = $"/uploads/{fileName}";
        }
    }

    private async Task HandleSaveLecture()
    {
        currentLecture.Content = await lectureForm.GetHtmlContent();

        if (!isEditing)
        {
            currentLecture.AuthorId = currentUserId;
        }

        if (isEditing)
            await LectureService.UpdateLectureAsync(currentLecture);
        else
            await LectureService.AddLectureAsync(currentLecture);

        currentLecture = new() { ImagePath = "/images/default-lecture.png" };
        await lectureForm.SetHtmlContent("");
        isEditing = false;

        await LoadLectures();
        StateHasChanged(); 
    }

    private async Task StartEdit(Lecture lecture)
    {
        currentLecture = new Lecture
        {
            
            Id = lecture.Id,

            Title = lecture.Title,

            TargetDiagnosis = lecture.TargetDiagnosis,

            Description = lecture.Description,

            Content = lecture.Content,

            VideoUrl = lecture.VideoUrl,

            ImagePath = lecture.ImagePath,

            AuthorId = lecture.AuthorId
        };
        isEditing = true;
        StateHasChanged();

        await Task.Delay(100);

        if (lectureForm != null)
        {
            await lectureForm.SetHtmlContent(currentLecture.Content ?? "");
        }
    }

    private async Task CancelEditing()
    {
        currentLecture = new Lecture { ImagePath = "/images/default-lecture.png" };
        isEditing = false;
        await lectureForm.SetHtmlContent("");
    }
    private async Task HandleAddCategoryFromModal()
    {
        categoryErrorMessage = null; 

        if (!string.IsNullOrWhiteSpace(newCategoryName))
        {
            bool success = await CategoryService.AddCategoryAsync(new Category { Name = newCategoryName });

            if (success)
            {
                await JS.InvokeVoidAsync("hideCategoryModal");
                allCategories = await CategoryService.GetAllCategoriesAsync();
                newCategoryName = "";
            }
            else
            {
                categoryErrorMessage = L["CategoryAlreadyExistsError"]; 
            }
        }
    }
    private async Task OpenCategoryModal()
    {
        await JS.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('categoryModal')).show()");
    }
   
}

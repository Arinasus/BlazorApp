@page "/admin/lectures"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using Blazorized.HtmlTextEditor
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.Extensions.Localization
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin, Therapist")]
@inject ILectureService LectureService
@inject IWebHostEnvironment WebHostEnvironment
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<ManageLectures> L
<PageTitle>@L["KnowledgeBaseTitle"]</PageTitle>

<div class="container mt-4 pb-5">
    <h3 class="fw-bold mb-4">@L["KnowledgeBaseTitle"]</h3>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header border-0 p-4 rounded-top-4 @(isEditing ? "bg-warning-subtle text-warning-dark" : "bg-coral-light text-coral")">
            <h5 class="mb-0 fw-bold">@(isEditing? L["EditLectureHeader"] : L["AddLectureHeader"])</h5>
        </div>
        <div class="card-body p-4">
            <EditForm Model="currentLecture" OnValidSubmit="HandleSaveLecture">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["LectureTitleLabel"]</label>
                        <InputText @bind-Value="currentLecture.Title" class="form-control" placeholder=" " />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["TargetDiagnosisLabel"]</label>
                        <InputText @bind-Value="currentLecture.TargetDiagnosis" class="form-control" placeholder=" " />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["LectureCoverLabel"]</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".jpg,.png" />
                    @if (!string.IsNullOrEmpty(currentLecture.ImagePath))
                    {
                        <div class="mt-2 position-relative d-inline-block">
                            <img src="@currentLecture.ImagePath" class="rounded-3 shadow-sm" style="height:80px; object-fit: cover;" />
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["ShortDescriptionLabel"]</label>
                    <InputTextArea @bind-Value="currentLecture.Description" class="form-control" rows="2" placeholder=" " />
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["FullTextLabel"]</label>
                    <div class="editor-container rounded-3 border bg-white">
                        <HtmlTextEditor @ref="@QuillHtml" Placeholder="@L["EditorPlaceholder"]">
                            <ToolbarContent>
                                <select class="ql-header">
                                    <option selected=""></option>
                                    <option value="1"></option>
                                    <option value="2"></option>
                                </select>
                                <span class="ql-formats">
                                    <button class="ql-bold"></button>
                                    <button class="ql-italic"></button>
                                </span>
                            </ToolbarContent>
                        </HtmlTextEditor>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">@L["VideoUrlLabel"]</label>
                    <InputText @bind-Value="currentLecture.VideoUrl" class="form-control" placeholder="https://youtube.com/..." />
                </div>

                <div class="d-flex gap-2">
                    @if (isEditing)
                    {
                        <button type="submit" class="btn btn-warning px-4 rounded-pill">@L["BtnSaveChanges"]</button>
                        <button type="button" class="btn btn-secondary px-4 rounded-pill" @onclick="CancelEditing">@L["BtnCancel"]</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">@L["BtnPublish"]</button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <h4 class="fw-bold mt-5 mb-3">@L["AvailableLecturesHeader"]</h4>
    <div class="card border-0 shadow-sm rounded-4 p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["ThTitle"]</th>
                        <th>@L["ThDiagnosis"]</th>
                        <th class="text-end">@L["ThActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (displayedLectures != null)
                    {
                        @foreach (var lecture in displayedLectures)
                        {
                            <tr>
                                <td class="fw-bold">@lecture.Title</td>
                                <td>
                                    <span class="badge bg-secondary text-white rounded-pill px-3 py-2">
                                        @lecture.TargetDiagnosis
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => StartEdit(lecture)">
                                            @L["BtnEdit"]
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteLecture(lecture.Id, lecture.Title)">
                                            @L["BtnDelete"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">@L["LoadingLecturesText"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private Lecture currentLecture = new();
    private List<Lecture>? displayedLectures;
    private HtmlTextEditor QuillHtml = default!;

    private bool isEditing = false;
    private string currentUserId = string.Empty;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentUserId = user.Id;
            isAdmin = authState.User.IsInRole("Admin");
        }

        await LoadLectures();
    }

    private async Task LoadLectures()
    {
        if (isAdmin)
        {
            displayedLectures = await LectureService.GetAllLecturesAsync();
        }
        else
        {
            displayedLectures = await LectureService.GetLecturesByAuthorAsync(currentUserId);
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);
            var folderPath = Path.Combine(WebHostEnvironment.WebRootPath, "uploads");

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            var filePath = Path.Combine(folderPath, fileName);
            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var fileStream = new FileStream(filePath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            currentLecture.ImagePath = $"/uploads/{fileName}";
        }
    }

    private async Task HandleSaveLecture()
    {
        currentLecture.Content = await QuillHtml.GetHtml();

        if (isEditing)
        {
            await LectureService.UpdateLectureAsync(currentLecture);
            isEditing = false;
        }
        else
        {
            currentLecture.AuthorId = currentUserId;
            await LectureService.AddLectureAsync(currentLecture);
        }

        currentLecture = new();
        await QuillHtml.LoadHtmlContent("");
        await LoadLectures();
    }

    private async Task StartEdit(Lecture lecture)
    {
        currentLecture = lecture;
        isEditing = true;

        if (QuillHtml != null)
        {
            await QuillHtml.LoadHtmlContent(currentLecture.Content ?? "");
        }
    }

    private async Task CancelEditing()
    {
        currentLecture = new();
        isEditing = false;
        await QuillHtml.LoadHtmlContent("");
    }

    private async Task DeleteLecture(int id, string title)
    {
        var confirmText = string.Format(L["DeleteLectureConfirmText"], title);
        bool confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (confirmed)
        {
            await LectureService.DeleteLectureAsync(id);
            await LoadLectures();
        }
    }
}
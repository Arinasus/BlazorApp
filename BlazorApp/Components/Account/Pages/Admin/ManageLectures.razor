@page "/admin/lectures"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using Blazorized.HtmlTextEditor
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin, Therapist")]
@inject ILectureService LectureService
@inject IWebHostEnvironment WebHostEnvironment
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ICategoryService CategoryService 
@inject IStringLocalizer<ManageLectures> L
<PageTitle>@L["KnowledgeBaseTitle"]</PageTitle>

<LectureEditor @ref="lectureForm" 
               Lecture="currentLecture" 
               Categories="allCategories" 
               IsAdmin="isAdmin"
               IsEditing="isEditing"
               OnSave="HandleSaveLecture" 
               OnCancel="CancelEditing"
               OnFileSelected="HandleFileSelected" 
               OnOpenCategoryModal="OpenCategoryModal" />
<h4 class="fw-bold mt-5 mb-3">@L["AvailableLecturesHeader"]</h4>
<LectureTable Lectures="displayedLectures"
              OnEdit="StartEdit"
              OnDelete="HandleDeleteRequest" 
              />

@page "/admin/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.DTOs
@using BlazorApp.Shared.Interfaces
@using Blazorized.HtmlTextEditor
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Localization

@attribute [Authorize(Roles = "Admin")]

@inject ILectureService LectureService
@inject IUserService UserService
@inject IWebHostEnvironment WebHostEnvironment
@inject IJSRuntime JS
@inject IStringLocalizer<AdminDashboard> L
@inject ICategoryService CategoryService

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="container mt-4 pb-5">
    <div class="d-flex align-items-center mb-4">
        <h2 class="fw-bold me-auto">@L["DashboardTitle"]</h2>
        <span class="badge bg-coral-light text-coral px-3 py-2 rounded-pill">@L["AdminModeBadge"]</span>
    </div>

    <ul class="nav nav-pills mb-4" id="adminTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill me-2" data-bs-toggle="pill" data-bs-target="#content">
                <i class="bi bi-file-earmark-text me-2"></i>@L["TabContent"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#users">
                <i class="bi bi-people me-2"></i>@L["TabUsers"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#categories">
                <i class="bi bi-tag me-2"></i>@L["TabCategories"]
            </button>
        </li>
    </ul>

    <div class="tab-content mt-3">
        <div class="tab-pane fade show active" id="content">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">@L["AddLectureHeader"]</h5>
                    <EditForm Model="newLecture" OnValidSubmit="HandleAddLecture">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@L["LectureTitleLabel"]</label>
                                <InputText @bind-Value="newLecture.Title" class="form-control rounded-3" placeholder=" " />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@L["TargetDiagnosisLabel"]</label>
                                <InputText @bind-Value="newLecture.TargetDiagnosis" class="form-control rounded-3" placeholder=" " />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["LectureCoverLabel"]</label>
                            <InputFile OnChange="HandleFileSelected" class="form-control rounded-3" accept=".jpg,.png" />
                            @if (!string.IsNullOrEmpty(newLecture.ImagePath))
                            {
                                <div class="mt-2 position-relative d-inline-block">
                                    <img src="@newLecture.ImagePath" class="rounded-3 shadow-sm" style="height:100px; object-fit: cover;" />
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["ShortDescriptionLabel"]</label>
                            <InputTextArea @bind-Value="newLecture.Description" class="form-control rounded-3" rows="2" placeholder=" " />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["FullTextLabel"]</label>
                            <div class="editor-container rounded-3 border">
                                <HtmlTextEditor @ref="@QuillHtml" Placeholder="@L["EditorPlaceholder"]">
                                    <ToolbarContent>
                                        <select class="ql-header">
                                            <option selected=""></option>
                                            <option value="1"></option>
                                            <option value="2"></option>
                                        </select>
                                        <span class="ql-formats">
                                            <button class="ql-bold"></button>
                                            <button class="ql-italic"></button>
                                        </span>
                                    </ToolbarContent>
                                </HtmlTextEditor>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">@L["VideoUrlLabel"]</label>
                            <InputText @bind-Value="newLecture.VideoUrl" class="form-control rounded-3" placeholder="https://youtube.com/..." />
                        </div>

                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill">@L["BtnPublish"]</button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="users">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>@L["ThUser"]</th>
                                    <th>@L["ThRole"]</th>
                                    <th>@L["ThStatus"]</th>
                                    <th class="text-end">@L["ThActions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (allUsers != null)
                                {
                                    @foreach (var user in allUsers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@user.Email</div>
                                                <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm rounded-3"
                                                        @onchange="(e) => ChangeRole(user, e.Value?.ToString() ?? user.Role)">
                                                    <option value="User" selected="@(user.Role == "User")">@L["RoleUser"]</option>
                                                    <option value="Therapist" selected="@(user.Role == "Therapist")">@L["RoleTherapist"]</option>
                                                    <option value="Admin" selected="@(user.Role == "Admin")">@L["RoleAdmin"]</option>
                                                </select>
                                            </td>
                                            <td>
                                                @if (user.IsBlocked)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger rounded-pill">@L["StatusBlocked"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-2">
                                                        @L["StatusActive"]
                                                    </span>

                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm @(user.IsBlocked ? "btn-outline-success" : "btn-outline-warning") border-0 me-2"
                                                        @onclick="() => ToggleBlock(user)" title="@(user.IsBlocked ? L["TooltipUnlock"] : L["TooltipLock"])">
                                                    <i class="bi @(user.IsBlocked ? "bi-unlock" : "bi-lock")"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger border-0"
                                                        @onclick="() => PrepareDelete(user.Id)"
                                                        title="@L["TooltipDelete"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="categories">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">@L["AddCategoryHeader"]</h5>
                    <div class="input-group">
                        <input @bind="newCategoryName" class="form-control rounded-start-pill" placeholder="@L["CategoryNamePlaceholder"]" />
                        <button class="btn btn-primary rounded-end-pill px-4" @onclick="HandleAddCategory">@L["BtnAdd"]</button>
                    </div>

                    @if (!string.IsNullOrEmpty(categoryErrorMessage))
                    {
                        <div class="text-danger mt-2 small ms-2">@categoryErrorMessage</div>
                    }

                    <ul class="list-group list-group-flush mt-3">
                        @foreach (var cat in allCategories)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @cat.Name
                                @if (!cat.IsSystem)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(cat.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
                <h5 class="mt-3">@L["DeleteConfirmationTitle"]</h5>
                <p class="text-muted">@L["DeleteConfirmationText"]</p>
            </div>
            <div class="modal-footer border-0 justify-content-center p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">@L["BtnCancel"]</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" @onclick="ConfirmDelete">
                    @L["BtnDelete"]
                </button>
            </div>
        </div>
    </div>
</div>
@code {
    private Lecture newLecture = new();
    private List<Lecture>? allLectures;
    private List<UserDto>? allUsers;
    private HtmlTextEditor QuillHtml = default!;
    private string? userIdToDelete;
    private List<Category> allCategories = new();
    private string newCategoryName = "";
    private string? categoryErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLectures();
        await LoadUsers();
        allCategories = await CategoryService.GetAllCategoriesAsync();
    }

    private async Task LoadLectures()
    {
        allLectures = await LectureService.GetAllLecturesAsync();
    }

    private async Task LoadUsers()
    {
        allUsers = await UserService.GetAllUsersAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);
            var folderPath = Path.Combine(WebHostEnvironment.WebRootPath, "uploads");

            if (!Directory.Exists(folderPath))
                Directory.CreateDirectory(folderPath);

            var filePath = Path.Combine(folderPath, fileName);

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var fileStream = new FileStream(filePath, FileMode.Create);
            await stream.CopyToAsync(fileStream);

            newLecture.ImagePath = $"/uploads/{fileName}";
        }
    }

    private async Task HandleAddLecture()
    {
        newLecture.Content = await QuillHtml.GetHtml();
        await LectureService.AddLectureAsync(newLecture);

        newLecture = new();
        await QuillHtml.LoadHtmlContent("");
        await LoadLectures();
    }

    private async Task ChangeRole(UserDto user, string newRole)
    {
        await UserService.UpdateRoleAsync(user.Id, newRole);
        user.Role = newRole;
    }

    private async Task ToggleBlock(UserDto user)
    {
        user.IsBlocked = !user.IsBlocked;
        await UserService.UpdateBlockStatusAsync(user.Id, user.IsBlocked);
    }


    private async Task PrepareDelete(string userId)
    {
        userIdToDelete = userId;
        await JS.InvokeVoidAsync("showDeleteModal");
    }

    private async Task ConfirmDelete()
    {
        if (!string.IsNullOrEmpty(userIdToDelete))
        {
            await UserService.DeleteUserAsync(userIdToDelete);

            await JS.InvokeVoidAsync("hideDeleteModal");

            await JS.InvokeVoidAsync("eval", "document.querySelectorAll('.modal-backdrop').forEach(el => el.remove()); document.body.classList.remove('modal-open'); document.body.style.overflow = '';");

            userIdToDelete = null;
            await LoadUsers();
        }
    }
    private async Task HandleAddCategory()
    {
        categoryErrorMessage = null; 

        if (!string.IsNullOrWhiteSpace(newCategoryName))
        {
            bool success = await CategoryService.AddCategoryAsync(new Category { Name = newCategoryName });

            if (success)
            {
                newCategoryName = "";
                allCategories = await CategoryService.GetAllCategoriesAsync();
            }
            else
            {
                categoryErrorMessage = L["CategoryAlreadyExistsError"];
            }
        }
    }

    private async Task DeleteCategory(int id)
    {
        await CategoryService.DeleteCategoryAsync(id);
        allCategories = await CategoryService.GetAllCategoriesAsync();
    }
}

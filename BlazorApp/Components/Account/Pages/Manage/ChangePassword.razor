@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger
@inject IEmailSender<ApplicationUser> EmailSender
@inject IStringLocalizer<ChangePassword> L

<PageTitle>@L["PageTitle"]</PageTitle>

<h3 class="fw-bold mb-3">@L["Header"]</h3>
<StatusMessage Message="@message" />

<div class="row animate-fade">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small" role="alert" />

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@L["OldPasswordPlaceholder"]" />
                <label for="old-password" class="form-label">@L["OldPasswordLabel"]</label>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger small" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["NewPasswordPlaceholder"]" />
                <label for="new-password" class="form-label">@L["NewPasswordLabel"]</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger small" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@L["ConfirmPasswordPlaceholder"]" />
                <label for="confirm-password" class="form-label">@L["ConfirmPasswordLabel"]</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary rounded-pill py-2 fw-bold shadow-sm">@L["BtnUpdate"]</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            var translatedErrors = changePasswordResult.Errors.Select(error =>
            {
                var localizedError = L[$"Identity_{error.Code}"];
                return localizedError.ResourceNotFound ? error.Description : localizedError.Value;
            });

            message = $"{L["ErrorPrefix"]}: {string.Join(", ", translatedErrors)}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        var userEmail = await UserManager.GetEmailAsync(user);
        if (!string.IsNullOrEmpty(userEmail))
        {
            try
            {
                string emailBody = "<h3>" + L["EmailSubject"] + "</h3>" +
                                   "<p>" + L["EmailGreeting"] + ", " + user.UserName + "!</p>" +
                                   "<p>" + L["EmailBodyText"] + "</p>" +
                                   "<p><small>" + L["EmailFooterText"] + "</small></p>";

                await EmailSender.SendPasswordResetLinkAsync(user, userEmail, emailBody);
            }
            catch (Exception ex)
            {
                Logger.LogError($"Не удалось отправить email-уведомление о смене пароля: {ex.Message}");
            }
        }

        RedirectManager.RedirectToCurrentPageWithStatus(L["SuccessMessage"], HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(ChangePassword), ErrorMessageResourceName = "ErrOldPasswordRequired")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(ChangePassword), ErrorMessageResourceName = "ErrNewPasswordRequired")]
        [StringLength(100, MinimumLength = 6, ErrorMessageResourceType = typeof(ChangePassword), ErrorMessageResourceName = "ErrPasswordLength")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessageResourceType = typeof(ChangePassword), ErrorMessageResourceName = "ErrPasswordsMismatch")]
        public string ConfirmPassword { get; set; } = "";
    }
}
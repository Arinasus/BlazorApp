@page "/children"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@attribute [Authorize]
@inject IChildService ChildService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IStringLocalizer<Children> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="container mt-4">
    <h3 class="fw-bold mb-4">@L["Header"]</h3>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">@(isEditMode? L["FormEditHeader"] : L["FormAddHeader"])</h5>
                <EditForm Model="activeChild" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">@L["LabelName"]</label>
                        <InputText @bind-Value="activeChild.Name" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["LabelAge"]</label>
                        <InputNumber @bind-Value="activeChild.Age" class="form-control rounded-3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["LabelDiagnosis"]</label>
                        <InputTextArea @bind-Value="activeChild.Diagnosis" class="form-control rounded-3" rows="3" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            @(isEditMode? L["BtnSaveChanges"] : L["BtnAddChild"])
                        </button>
                        @if (isEditMode)
                        {
                            <button type="button" class="btn btn-secondary rounded-pill px-4" style="background-color: #e9ecef; color: #495057; border: none;" @onclick="CancelEdit">
                                @L["BtnCancel"]
                            </button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-md-8">
            <h5 class="fw-bold mb-3">@L["ListHeader"]</h5>
            @if (children == null)
            {
                <div class="text-center p-5"><div class="spinner-border" style="color: #FF8A5B;"></div></div>
            }
            else if (!children.Any())
            {

                <div class="alert alert-light rounded-4 border-0 shadow-sm">@L["EmptyListMessage"]</div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var child in children)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 mb-3 shadow-sm rounded-4 p-3 bg-white">
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">@child.Name</h6>
                                <span class="badge bg-light text-muted border rounded-pill small">@child.Age @L["AgeSuffix"]</span>
                                @if (!string.IsNullOrEmpty(child.Diagnosis))
                                {
                                    <p class="small text-muted mb-2 mt-2"><i class="bi bi-info-circle me-1"></i> @child.Diagnosis</p>
                                }
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input coral-switch" type="checkbox" id="flexSwitch-@child.Id"
                                           checked="@child.IsDiaryVisible"
                                           @onchange="@((e) => ToggleVisibility(child, (bool)e.Value!))">
                                    <label class="form-check-label small" for="flexSwitch-@child.Id">@L["AllowTherapistAccess"]</label>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-icon-edit" @onclick="() => EditChild(child)"><i class="bi bi-pencil-square"></i></button>
                                <button class="btn btn-icon-delete" @onclick="() => DeleteChild(child)"><i class="bi bi-trash3"></i></button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .coral-switch:checked {
        background-color: #FF8A5B !important;
        border-color: #FF8A5B !important;
    }
    .btn-icon-edit {
        color: #FF8A5B;
        border: none;
        background: none;
    }

    .btn-icon-delete {
        color: #6c757d;
        border: none;
        background: none;
    }
    .coral-switch:focus {
        border-color: #FF8A5B !important;
        box-shadow: 0 0 0 0.25rem rgba(255, 138, 91, 0.25) !important;
    }

    .coral-switch:active {
        filter: brightness(0.9);
    }

    .btn-secondary {
        transition: all 0.2s ease-in-out;
    }

        .btn-secondary:hover {
            background-color: #d3d9df !important; 
            transform: translateY(-2px); 
        }

    .coral-switch {
        background-color: #dee2e6 !important; 
    }

        .coral-switch:checked {
            background-color: #FF8A5B !important;
            border-color: #FF8A5B !important;
        }

        .coral-switch:checked::after {
            background-color: #ffffff !important;
        }
</style>

@code {
    private List<Child>? children;
    private Child activeChild = new();
    private bool isEditMode = false;

    protected override async Task OnInitializedAsync() => await LoadChildren();

    private async Task LoadChildren()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            children = await ChildService.GetChildrenByParentIdAsync(userId);
        }
    }
    private async Task HandleSubmit()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId)) return; 

        activeChild.ParentId = userId;

        if (isEditMode)
        {
            await ChildService.UpdateChildAsync(activeChild);
        }
        else
        {
            await ChildService.AddChildAsync(activeChild);
        }

        activeChild = new();
        isEditMode = false;
        await LoadChildren();
    }
    private void EditChild(Child child)
    {
        activeChild = new Child
        {
            Id = child.Id,
            Name = child.Name,
            Age = child.Age,
            Diagnosis = child.Diagnosis,
            ParentId = child.ParentId
        };
        isEditMode = true;
    }

    private void CancelEdit()
    {
        activeChild = new();
        isEditMode = false;
    }


    private async Task DeleteChild(Child child)
    {
        var confirmText = string.Format(L["DeleteConfirmText"], child.Name);
        bool confirmed = await JS.InvokeAsync<bool>("confirm", confirmText);
        if (confirmed)
        {
            await ChildService.DeleteChildAsync(child.Id);
            await LoadChildren();
        }
    }
    private async Task ToggleVisibility(Child child, bool isVisible)
    {
        child.IsDiaryVisible = isVisible;

        await ChildService.UpdateChildAsync(child);

    }
}
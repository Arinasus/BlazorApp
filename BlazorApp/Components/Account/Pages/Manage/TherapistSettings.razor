@page "/Account/Manage/TherapistSettings"
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Therapist")]

@inject ITherapistService TherapistService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IWebHostEnvironment Environment
@inject IStringLocalizer<BecomeTherapist> L

<h3 class="text-coral fw-bold mb-4">@L["SettingsTitle"]</h3>

<EditForm Model="profile" OnValidSubmit="HandleSubmit" class="row g-3" FormName="TherapistProfileForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger small" />
    <InputText @bind-Value="profile.CertificateUrls" hidden />
    <InputNumber @bind-Value="profile.Id" hidden />
    <InputText @bind-Value="profile.UserId" hidden />
    <InputText @bind-Value="profile.ImageUrl" hidden />

    <div class="col-md-12 d-flex align-items-center gap-4 mb-3">
        <div class="position-relative">
            <img src="@(string.IsNullOrEmpty(profile.ImageUrl) ? "/img/default-avatar.png" : profile.ImageUrl)"
                 class="rounded-circle border shadow-sm"
                 style="width: 120px; height: 120px; object-fit: cover;" />
        </div>
        <div class="flex-grow-1" style="max-width: 300px;">
            <label class="form-label fw-bold">@L["ProfilePhoto"]</label>
            <InputFile OnChange="LoadFiles" class="form-control form-control-sm" accept=".jpg,.jpeg,.png" />
            <div class="form-text">@L["PhotoHint"]</div>
        </div>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">@L["LastName"]</label>
        <InputText @bind-Value="profile.LastName" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">@L["FirstName"]</label>
        <InputText @bind-Value="profile.FirstName" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">@L["MiddleName"]</label>
        <InputText @bind-Value="profile.MiddleName" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">@L["Specialization"]</label>
        <InputText @bind-Value="profile.Specialization" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-bold">@L["Experience"]</label>
        <InputNumber @bind-Value="profile.ExperienceYears" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label fw-bold">@L["Price"] (<i class="nbrb-icon">BYN</i>)</label>
        <InputNumber @bind-Value="profile.PricePerHour" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">@L["WorkFormat"]</label>

        <InputSelect @bind-Value="profile.WorkFormat" @bind-Value:after="OnWorkFormatUpdated" class="form-select">
            <option value="Online">@L["FormatOnline"]</option>
            <option value="Offline">@L["FormatOffline"]</option>
            <option value="Hybrid">@L["FormatHybrid"]</option>
        </InputSelect>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">@L["Phone"]</label>
        <InputText @bind-Value="profile.Phone" class="form-control" placeholder="+375..." />
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">@L["City"]</label>
        <InputText @bind-Value="profile.City" class="form-control" />
    </div>

    @if (profile.WorkFormat != "Online")
    {
        <div class="col-md-12 animate-fade">
            <label class="form-label fw-bold">@L["Address"]</label>
            <InputText @bind-Value="profile.Address" class="form-control" placeholder="@L["AddressPlaceholder"]" />
        </div>
    }
    <div class="col-md-12">
        <label class="form-label fw-bold">@L["WorkType"]</label>
        <InputSelect @bind-Value="profile.WorkType" class="form-select">
            <option value="Индивидуальные">Индивидуальные</option>
            <option value="Групповые">Групповые</option>
            <option value="Индивидуальные и групповые">Индивидуальные и групповые</option>
        </InputSelect>
    </div>

    <div class="col-md-12">
        <label class="form-label fw-bold">@L["SpeechDisorders"]</label>
        <InputText @bind-Value="profile.SpeechDisorders" class="form-control" placeholder="Например: Дислалия; Дизартрия" />
    </div>

    <div class="col-md-12">
        <label class="form-label fw-bold">@L["SpecialNeeds"]</label>
        <InputText @bind-Value="profile.SpecialNeeds" class="form-control" />
    </div>

    <div class="col-md-12">
        <div class="d-flex gap-4">
            <div class="form-check">
                <InputCheckbox @bind-Value="profile.IsSelfEmployed" class="form-check-input" id="isSelfEmployed" />
                <label class="form-check-label" for="isSelfEmployed">@L["IsSelfEmployed"]</label>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <label class="form-label fw-bold">@L["Education"]</label>
        <InputTextArea @bind-Value="profile.Education" class="form-control" rows="2" />
    </div>
    <div class="col-md-12">
        <label class="form-label fw-bold">@L["UploadCertificates"]</label>
        <InputFile OnChange="UploadCertificate" class="form-control" />

        <div class="d-flex flex-wrap gap-3 mt-3">
            @foreach (var url in certificateList)
            {
                <div class="position-relative" style="width: 100px; height: 100px;">
                    <div class="border rounded shadow-sm overflow-hidden w-100 h-100">
                        @if (url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                                <i class="bi bi-file-earmark-pdf fs-2 text-danger"></i>
                            </div>
                        }
                        else
                        {
                            <img src="@url" class="img-fluid w-100 h-100" style="object-fit: cover;" />
                        }
                    </div>

                    <button type="button"
                            class="btn btn-danger btn-sm rounded-circle position-absolute"
                            @onclick="() => RemoveCertificate(url)"
                            style="top: -10px; right: -10px; width: 25px; height: 25px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
        </div>
    </div>
    <div class="col-md-12">
        <label class="form-label fw-bold">@L["FullBio"]</label>
        <InputTextArea @bind-Value="profile.FullBio" class="form-control" rows="5" />
    </div>

    <div class="col-md-12">
        <label class="form-label fw-bold">@L["ShortDescription"]</label>
        <InputText @bind-Value="profile.ShortDescription" class="form-control" />
    </div>

    <div class="col-12 mt-4">
        <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">@L["SaveButton"]</button>
        @if (showSuccessMessage)
        {
            <span class="text-success ms-3 animate-fade">
                <i class="bi bi-check-circle-fill"></i> @L["SavedSuccess"]
            </span>
        }
    </div>
</EditForm>

@code {
    private TherapistProfile profile { get; set; } = new();
    private List<string> certificateList = new();
    private bool showSuccessMessage = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            var existingProfile = await TherapistService.GetProfileByUserId(user.Id);
            if (existingProfile != null)
            {
                profile = existingProfile;
                if (!string.IsNullOrEmpty(profile.CertificateUrls))
                {
                    certificateList = profile.CertificateUrls.Split(';', StringSplitOptions.RemoveEmptyEntries).ToList();
                }
            }
            else
            {
                profile.UserId = user.Id;
            }
        }
    }

    private async Task HandleSubmit(EditContext editContext)
    {
        bool isValid = editContext.Validate();
        if (isValid)
        {
            await TherapistService.UpdateProfile(profile);
            showSuccessMessage = true;
            StateHasChanged();
            await Task.Delay(2000);
            showSuccessMessage = false;
        }
        else
        {
            Console.WriteLine("Форма не прошла валидацию");
        }
    }


    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                var fileName = $"{Guid.NewGuid()}_{file.Name}";
                var uploadsPath = Path.Combine(Environment.WebRootPath, "uploads", "avatars");

                if (!Directory.Exists(uploadsPath))
                    Directory.CreateDirectory(uploadsPath);

                var fullPath = Path.Combine(uploadsPath, fileName);

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 2);
                using var fileStream = new FileStream(fullPath, FileMode.Create);
                await stream.CopyToAsync(fileStream);

                profile.ImageUrl = $"/uploads/avatars/{fileName}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при загрузке: {ex.Message}");
            }
        }
    }

    private void OnWorkFormatUpdated()
    {
        if (profile.WorkFormat == "Online")
        {
            profile.Address = null;
        }
        StateHasChanged();
    }
    private async Task UploadCertificate(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var fileName = $"{Guid.NewGuid()}_{file.Name}";
        var uploadsPath = Path.Combine(Environment.WebRootPath, "uploads", "certificates");
        if (!Directory.Exists(uploadsPath)) Directory.CreateDirectory(uploadsPath);

        var fullPath = Path.Combine(uploadsPath, fileName);

        using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
        using var fileStream = new FileStream(fullPath, FileMode.Create);
        await stream.CopyToAsync(fileStream);

        // Добавляем в список
        certificateList.Add($"/uploads/certificates/{fileName}");

        // Обновляем модель
        profile.CertificateUrls = string.Join(";", certificateList);

        // Сохраняем
        await TherapistService.UpdateProfile(profile);

        // ПЕРЕЧИТЫВАЕМ профиль из БД
        var updated = await TherapistService.GetProfileByUserId(profile.UserId);
        if (updated != null)
        {
            profile = updated;
            certificateList = profile.CertificateUrls?.Split(';', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new();
        }

        StateHasChanged();
    }

    private async Task RemoveCertificate(string url)
    {
        certificateList.Remove(url);
        profile.CertificateUrls = string.Join(";", certificateList);

        await TherapistService.UpdateProfile(profile);

        var updated = await TherapistService.GetProfileByUserId(profile.UserId);
        if (updated != null)
        {
            profile = updated;
            certificateList = profile.CertificateUrls?.Split(';', StringSplitOptions.RemoveEmptyEntries).ToList() ?? new();
        }

        StateHasChanged();
    }


    private void UpdateProfileUrls()
    {
        profile.CertificateUrls = string.Join(";", certificateList);
    }
}
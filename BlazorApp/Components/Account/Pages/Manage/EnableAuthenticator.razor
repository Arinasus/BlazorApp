@page "/Account/Manage/EnableAuthenticator"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using BlazorApp.Services 

@inject EmailSender EmailSender
@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<EnableAuthenticator> Logger

<PageTitle>Настройка двухэтапной аутентификации</PageTitle>

<StatusMessage Message="@message" />
<h3>Подтверждение включения 2FA</h3>

<div class="row">
    <div class="col-md-6">
        @if (!codeSent)
        {
            <p>Для активации защиты нам нужно проверить, что ваш Email активен. Нажмите на кнопку ниже, чтобы получить проверочный код.</p>
            <button type="button" class="btn btn-primary" @onclick="SendVerificationCodeAsync">Отправить код на почту</button>
        }
        else
        {
            <p class="text-success"><strong>Код успешно отправлен!</strong> Проверьте ваш почтовый ящик и введите 6-значный код ниже.</p>

            <EditForm Model="Input" FormName="send-code" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Code" class="form-control" autocomplete="off" placeholder="Введите код" />
                    <label for="code" class="control-label form-label">Код подтверждения</label>
                    <ValidationMessage For="() => Input.Code" class="text-danger" />
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Подтвердить и включить</button>
                <ValidationSummary class="text-danger" role="alert" />
            </EditForm>
        }
    </div>
</div>

@code {
    private string? message;
    private bool codeSent = false;
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }

    private async Task SendVerificationCodeAsync()
    {
        var email = await UserManager.GetEmailAsync(user);
        if (string.IsNullOrEmpty(email))
        {
            message = "Error: У вашего аккаунта не указан Email.";
            return;
        }

        // Генерируем стандартный безопасный токен 2FA для почты
        var code = await UserManager.GenerateTwoFactorTokenAsync(user, TokenOptions.DefaultEmailProvider);

        // Теперь этот метод 100% вызовется, так как мы работаем напрямую с твоим классом!
        await EmailSender.SendTwoFactorCodeAsync(user, email, code);

        codeSent = true;
        message = "Код подтверждения отправлен на вашу почту.";
    }

    private async Task OnValidSubmitAsync()
    {
        var verificationCode = Input.Code.Replace(" ", string.Empty).Replace("-", string.Empty);

        var is2faTokenValid = await UserManager.VerifyTwoFactorTokenAsync(
            user, TokenOptions.DefaultEmailProvider, verificationCode);

        if (!is2faTokenValid)
        {
            message = "Error: Неверный код подтверждения. Попробуйте еще раз.";
            return;
        }

        // Включаем 2FA
        await UserManager.SetTwoFactorEnabledAsync(user, true);

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("Пользователь с ID '{UserId}' успешно включил 2FA через Email.", userId);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "Двухэтапная аутентификация через Email успешно настроена и активна.",
            HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Введите код")]
        [StringLength(7, ErrorMessage = "Код должен состоять из 6 символов.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Код подтверждения")]
        public string Code { get; set; } = "";
    }
}
@page "/Account/Manage/SetPassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<SetPassword> L

<PageTitle>@L["PageTitle"]</PageTitle>

<h3 class="fw-bold mb-3">@L["Header"]</h3>
<StatusMessage Message="@message" />

<p class="text-info mb-4">
    @L["Description"]
</p>

<div class="row animate-fade">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small" role="alert" />

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="@L["NewPasswordPlaceholder"]" />
                <label class="form-label">@L["NewPasswordLabel"]</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger small" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="@L["ConfirmPasswordPlaceholder"]" />
                <label class="form-label">@L["ConfirmPasswordLabel"]</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary rounded-pill py-2 fw-bold shadow-sm">@L["BtnSetPassword"]</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        if (await UserManager.HasPasswordAsync(user))
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var result = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!result.Succeeded)
        {
            message = $"{L["ErrPrefix"]}: {string.Join(", ", result.Errors.Select(e => e.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus(L["MsgSuccess"], HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessageResourceType = typeof(SetPassword), ErrorMessageResourceName = "ErrRequired")]
        [StringLength(100, ErrorMessageResourceType = typeof(SetPassword), ErrorMessageResourceName = "ErrLength", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessageResourceType = typeof(SetPassword), ErrorMessageResourceName = "ErrCompare")]
        public string? ConfirmPassword { get; set; }
    }
}
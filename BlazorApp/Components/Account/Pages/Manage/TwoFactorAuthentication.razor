@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Двухэтапная аутентификация (2FA)</PageTitle>

<StatusMessage />
<h3>Двухэтапная аутентификация (2FA)</h3>

@if (canTrack)
{
    if (is2faEnabled)
    {
        <div class="alert alert-success">
            <strong>Двухэтапная аутентификация включена.</strong> Коды подтверждения отправляются на ваш Email при каждом входе.
        </div>

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-secondary me-2">Забыть этот браузер</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-danger">Отключить 2FA</a>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Защитите свой аккаунт!</strong> При включении этой функции, после ввода пароля система дополнительно потребует одноразовый цифровой код, отправленный на вашу электронную почту.
        </div>

        <form @formname="enable-2fa" @onsubmit="OnSubmitEnable2faAsync" method="post">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-primary">Включить 2FA через Email</button>
        </form>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>Политика конфиденциальности и использования куки не принята.</strong>
        <p>Вы должны принять политику сайта перед включением двухфакторной аутентификации.</p>
    </div>
}

@code {
    private bool canTrack;
    private bool is2faEnabled;
    private bool isMachineRemembered;
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
    }

    private async Task OnSubmitEnable2faAsync()
    {
        // Включаем двухфакторку в базе данных
        var result = await UserManager.SetTwoFactorEnabledAsync(user, true);

        if (result.Succeeded)
        {
            // Перенаправляем на страницу подтверждения и отправки тестового кода
            RedirectManager.RedirectToWithStatus(
                "Account/Manage/EnableAuthenticator",
                "Пожалуйста, подтвердите вашу почту для активации 2FA.",
                HttpContext);
        }
        else
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Error: Не удалось включить 2FA.", HttpContext);
        }
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Браузер сброшен. При следующем входе в систему вам снова потребуется ввести код подтверждения.",
            HttpContext);
    }
}
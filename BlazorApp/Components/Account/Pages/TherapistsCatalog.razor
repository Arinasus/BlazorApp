@page "/therapists"
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using Microsoft.Extensions.Localization
@inject ITherapistService TherapistService
@inject IStringLocalizer<TherapistsCatalog> L
@rendermode InteractiveServer

<div class="catalog-container animate-fade">
    <div class="catalog-header text-center mb-5">
        <h1 class="catalog-title fw-bold">@L["CatalogTitle"]</h1>
        <p class="catalog-subtitle text-muted">@L["CatalogSubtitle"]</p>
    </div>

    <div class="filter-section p-4 rounded-4 shadow-sm mb-4 bg-light">
        <div class="search-group d-flex flex-wrap gap-3">
            <input type="text" class="form-control filter-input flex-grow-1"
                   placeholder="@L["SearchPlaceholder"]"
                   @bind="searchQuery" @bind:event="oninput" />

            <select class="form-select filter-select" @bind="selectedFormat" style="max-width: 200px;">
                <option value="">@L["FormatAny"]</option>
                <option value="Online">@L["FormatOnline"]</option>
                <option value="Offline">@L["FormatOffline"]</option>
                <option value="Hybrid">Гибридный</option>
            </select>
        </div>
    </div>

    <div class="therapist-grid row g-4">
        @if (FilteredTherapists.Any())
        {
            @foreach (var therapist in FilteredTherapists)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column therapist-card">
                        <div class="image-container position-relative" style="height: 240px; background: #f8f9fa;">
                            <img src="@(string.IsNullOrEmpty(therapist.ImageUrl) ? "/img/default-avatar.png" : therapist.ImageUrl)"
                                 class="w-100 h-100" style="object-fit: cover;"
                                 alt="@therapist.FirstName" />
                            <div class="rating-badge position-absolute bottom-3 end-3 bg-white px-3 py-1 rounded-pill shadow-sm fw-bold text-warning small">
                                <i class="bi bi-star-fill me-1"></i>@therapist.AverageRating.ToString("F1")
                            </div>
                        </div>

                        <div class="card-body p-4 d-flex flex-column justify-content-between flex-grow-1">
                            <div>
                                <h4 class="therapist-name fw-bold text-dark mb-1">@therapist.LastName @therapist.FirstName</h4>
                                <h6 class="therapist-spec text-coral fw-semibold mb-3">@therapist.Specialization</h6>
                                <p class="therapist-desc text-muted small line-clamp mb-4" style="height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @therapist.ShortDescription
                                </p>
                            </div>

                            <div>
                                <div class="details-row d-flex justify-content-between align-items-center border-top pt-3 mb-3">
                                    <span class="price fw-bold text-coral fs-5">
                                        @therapist.PricePerHour <span class="small text-muted fw-normal"><i class="nbrb-icon">BYN</i> / @L["Hour"]</span>
                                    </span>
                                    <span class="format badge bg-light text-secondary border rounded-pill px-3 py-1 small">
                                        <i class="bi bi-geo-alt me-1"></i>@(therapist.WorkFormat == "Online" || therapist.WorkFormat == "Онлайн" ? L["FormatOnline"] : L["FormatOffline"])
                                    </span>
                                </div>

                                <a href="/therapist/@therapist.UserId" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm btn-details">
                                    @L["BtnViewProfile"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="card border-0 shadow-sm rounded-4 p-5">
                    <i class="bi bi-search text-muted display-4 mb-3"></i>
                    <p class="text-muted mb-0">@L["EmptyStateText"]</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .text-coral {
        color: #FF8A5B;
    }

    .therapist-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .therapist-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    .btn-details {
        background: #FF8A5B;
        border: none;
        color: white;
    }

        .btn-details:hover {
            background: #e67a4e;
            color: white;
        }
</style>

@code{
    private List<TherapistProfile> allTherapists = new();
    private string searchQuery = "";
    private string selectedFormat = "";

    protected override async Task OnInitializedAsync()
    {
        allTherapists = await TherapistService.GetApprovedProfilesAsync();
    }

    private IEnumerable<TherapistProfile> FilteredTherapists => allTherapists
    .Where(t =>
        (string.IsNullOrEmpty(searchQuery) ||
         t.Specialization.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         t.LastName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         t.FirstName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(selectedFormat) || t.WorkFormat == selectedFormat));
}
        
@page "/therapists"
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using Microsoft.Extensions.Localization
@inject ITherapistService TherapistService
@inject IStringLocalizer<TherapistsCatalog> L
@rendermode InteractiveServer

<div class="catalog-container animate-fade">
    <div class="catalog-header text-center mb-5">
        <h1 class="catalog-title fw-bold">@L["CatalogTitle"]</h1>
        <p class="catalog-subtitle text-muted">@L["CatalogSubtitle"]</p>
    </div>

    <div class="row">
        <div class="col-12 col-md-3">
            <div class="filter-section p-4 rounded-4 shadow-sm mb-4 bg-light">
                <h5 class="fw-bold mb-3">@L["Filters"]</h5>
                
                <label class="small text-muted mb-1">@L["SearchPlaceholder"]</label>
                <input type="text" class="form-control filter-input mb-3"
                       placeholder="@L["SearchPlaceholder"]"
                       @bind="searchQuery" @bind:event="oninput" />

                <label class="small text-muted mb-1">@L["Format"]</label>
                <select class="form-select filter-select mb-3" @bind="selectedFormat">
                    <option value="">@L["FormatAny"]</option>
                    <option value="Online">@L["FormatOnline"]</option>
                    <option value="Offline">@L["FormatOffline"]</option>
                    <option value="Hybrid">@L["FormatHybrid"]</option>
                </select>
                <label class="small text-muted mb-1">@L["MinExperience"]</label>
                <input type="number" class="form-control filter-input mb-3"
                       placeholder="0" min="0" max="100"
                       @bind="minExperience" @bind:event="oninput" />
                <button class="btn btn-outline-secondary w-100 rounded-pill" @onclick="ResetFilters">
                    @L["ResetFilters"]
                </button>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <div class="therapist-grid row g-4">
                @if (FilteredTherapists.Any())
                {
                    @foreach (var therapist in FilteredTherapists)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden therapist-card d-flex flex-column">
                                <div class="image-container" style="height: 200px; background: #f8f9fa;">
                                    <img src="@(string.IsNullOrEmpty(therapist.ImageUrl) ? "/img/default-avatar.png" : therapist.ImageUrl)"
                                         class="w-100 h-100" style="object-fit: cover;" alt="@therapist.FirstName" />
                                </div>

                                <div class="card-body p-4 d-flex flex-column flex-grow-1">
                                    <div class="rating-container mb-2 d-flex align-items-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @if (i <= Math.Floor(therapist.AverageRating))
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else if (i - 0.5 <= therapist.AverageRating)
                                            {

                                                <i class="bi bi-star-half text-warning"></i>
                                            }
                                            else
                                            {

                                                <i class="bi bi-star text-warning"></i>
                                            }
                                        }
                                        <span class="ms-2 fw-bold text-warning">@therapist.AverageRating.ToString("F1")</span>
                                    </div>

                                    <h5 class="therapist-name mb-1">@therapist.LastName @therapist.FirstName</h5>
                                    <h6 class="therapist-spec mb-2">@therapist.Specialization</h6>

                                    <p class="therapist-desc flex-grow-1 mb-2">@therapist.ShortDescription</p>

                                    <small class="text-muted d-block mb-3 fw-bold">
                                        @L["ExperienceLabel"]: @therapist.ExperienceYears @GetExperienceLabel(therapist.ExperienceYears)
                                    </small>

                                    <div class="mt-auto">
                                        <div class="details-row d-flex justify-content-between align-items-center border-top pt-3 mb-3">
                                            <span class="price fw-bold text-dark">
                                                @therapist.PricePerHour
                                                <i class="nbrb-icon">BYN</i>
                                            </span>
                                            <span class="format badge bg-light text-secondary border rounded-pill px-2 py-1">
                                                <i class="bi bi-geo-alt me-1"></i> @L["Format" + therapist.WorkFormat]
                                            </span>
                                        </div>
                                        <a href="/therapist/@therapist.UserId" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">
                                            @L["BtnViewProfile"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                         <p class="text-muted">@L["EmptyStateText"]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .catalog-header {
        margin-top: 3rem;
        margin-bottom: 2rem;
    }

    .therapist-card {
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    .therapist-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 24px !important; 
        margin-bottom: 0.25rem !important;
    }
    .therapist-spec {
        font-size: 18px !important; 
        color: #FF7F50;
        margin-bottom: 0.5rem !important;
    }

    .therapist-desc {
        font-family: 'Inter', sans-serif;
        font-size: 15px !important;
        color: #4A4A4A;
        margin-bottom: 0.75rem !important;
        line-height: 1.4;
    }

    .rating-container {
        font-size: 1rem; 
        gap: 2px;
    }

    .price {
        font-size: 24px !important;
        display: flex;
        align-items: baseline;
        gap: 5px;
    }

    .currency-symbol {
        font-size: 16px !important;
        font-weight: 500;
        color: #6c757d;
    }

    .card-body {
        padding: 1.2rem !important; 
    }
        .therapist-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(255, 138, 91, 0.15) !important;
        }

    .image-container {
        border-bottom: 1px solid #f0f0f0;
    }
    .exp-label {
        margin-bottom: 0.5rem !important;
        font-size: 0.85rem;
    }

    .card-body small.text-muted {
        margin-bottom: 0.5rem !important;
    }
    .details-row {
        margin-top: 0.3rem !important;
        padding-top: 0.5rem !important;
    }
    .btn-details {
        font-size: 1rem !important;
        padding: 0.6rem !important;
    }

    .mb-2 {
        margin-bottom: 0.3rem !important;
    }
</style>

@code{
    private List<TherapistProfile> allTherapists = new();
    private string searchQuery = "";
    private string selectedFormat = "";
    private int minExperience = 0;

    protected override async Task OnInitializedAsync()
    {
        allTherapists = await TherapistService.GetApprovedProfilesAsync();
    }
    private void ResetFilters()
    {
        searchQuery = "";
        selectedFormat = "";
        minExperience = 0;
    }
    private string GetExperienceLabel(int years)
    {
        int mod10 = years % 10;
        int mod100 = years % 100;

        if (mod10 == 1 && mod100 != 11) return L["YearOne"];    
        if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 > 20)) return L["YearFew"]; 
        return L["YearMany"]; 
    }
    private IEnumerable<TherapistProfile> FilteredTherapists => allTherapists
        .Where(t =>
            (string.IsNullOrEmpty(searchQuery) ||
             t.Specialization.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
             t.LastName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
             t.FirstName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedFormat) || t.WorkFormat == selectedFormat) &&
            (t.ExperienceYears >= minExperience));

}
        
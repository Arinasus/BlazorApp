@page "/Account/LoginWith2fa"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using BlazorApp.Services
@using Microsoft.Extensions.Localization

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger
@inject EmailSender EmailSender
@inject IStringLocalizer<LoginWith2fa> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="container-sm mt-5" style="max-width: 450px;">
    <h2 class="text-center fw-bold mb-4">@L["Header"]</h2>
    <StatusMessage Message="@message" />

    <p class="text-muted text-center mb-4">
        <strong>@L["DescriptionBold"]</strong> @L["DescriptionText"]
    </p>

    <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        <input type="hidden" name="RememberMe" value="@RememberMe" />
        <DataAnnotationsValidator />

        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.TwoFactorCode" class="form-control rounded-pill" id="two-factor-code" placeholder="Код" />
            <label for="two-factor-code">@L["CodeLabel"]</label>
            <ValidationMessage For="() => Input.TwoFactorCode" class="text-danger" />
        </div>

        <div class="checkbox mb-4 ms-2">
            <label class="form-check-label d-flex align-items-center">
                <InputCheckbox @bind-Value="Input.RememberMachine" class="form-check-input me-2 custom-checkbox" />
                @L["RememberMachine"]
            </label>
        </div>

        <button type="submit" class="w-100 btn btn-lg btn-primary rounded-pill fw-bold">@L["BtnLogin"]</button>
        <ValidationSummary class="text-danger mt-3" role="alert" />
    </EditForm>
</div>

<style>
    .form-control {
        border: 1px solid #dddcdc !important;
        padding-left: 1.5rem !important;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(255, 138, 91, 0.25) !important;
            border-color: #FF8A5B !important;
        }

    .btn-primary {
        background-color: #FF8A5B !important;
        border-color: #FF8A5B !important;
    }

    .custom-checkbox {
        width: 1.25em;
        height: 1.25em;
        border: 2px solid #FF8A5B !important;
    }

        .custom-checkbox:checked {
            background-color: #FF8A5B !important;
            border-color: #FF8A5B !important;
        }
</style>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    private static bool hasSentCode = false;

    protected override async Task OnInitializedAsync()
    {
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync();

        if (user is null)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }
        if (!hasSentCode)
        {
        var code = await UserManager.GenerateTwoFactorTokenAsync(user, TokenOptions.DefaultEmailProvider);
            var email = await UserManager.GetEmailAsync(user); 
            await EmailSender.SendTwoFactorCodeAsync(user, email!, code);
            hasSentCode = true;
        }

    }

    private async Task OnValidSubmitAsync()
    {
        var code = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);

        var result = await SignInManager.TwoFactorSignInAsync(TokenOptions.DefaultEmailProvider, code, RememberMe, Input.RememberMachine);

        if (result.Succeeded)
        {
            hasSentCode = false;
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            message = L["ErrInvalidCode"];
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Поле обязательно для заполнения.")]
        [StringLength(7, ErrorMessage = "Код должен быть 6 символов.", MinimumLength = 6)]
        public string? TwoFactorCode { get; set; }
        public bool RememberMachine { get; set; }
    }
}
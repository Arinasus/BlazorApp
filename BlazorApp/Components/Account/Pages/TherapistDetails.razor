@page "/therapist/{UserId}"
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@inject ITherapistService TherapistService
@inject IFavoriteService FavoriteService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TherapistDetails> L
@inject IWebHostEnvironment Environment

<div class="profile-page">
    @if (profile == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-coral" role="status"></div>
        </div>
    }
    else
    {
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center sticky-lg-top" style="top: 100px;">
                        <div class="position-relative d-inline-block mx-auto mb-3">
                            <img src="@(string.IsNullOrEmpty(profile.ImageUrl) ? "/img/default-avatar.png" : profile.ImageUrl)"
                                 class="rounded-circle shadow-sm"
                                 style="width: 200px; height: 200px; object-fit: cover;" alt="Avatar" />
                            <button class="btn btn-light shadow-sm rounded-circle position-absolute bottom-0 end-0 p-2"
                                    @onclick="ToggleFavorite"
                                    style="width: 45px; height: 45px; border: 1px solid #eee;">
                                <i class="bi @(isFavorite ? "bi-heart-fill text-danger" : "bi-heart") fs-5"></i>
                            </button>
                        </div>

                        <h3 class="fw-bold text-dark mb-1">
                            @profile.LastName @profile.FirstName @profile.MiddleName
                        </h3>
                        <h5 class="text-muted mb-2">@profile.Specialization</h5>
                        <div class="rating-stars mb-3">
                            <span class="text-warning">★ @profile.AverageRating.ToString("F1")</span>
                        </div>

                        <div class="d-grid gap-2">
                            @if (!string.IsNullOrEmpty(currentUserId) && currentUserId != UserId)
                            {
                                <button class="btn btn-coral rounded-pill py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 mb-1"
                                        @onclick="NavigateToChat">
                                    <i class="bi bi-chat-dots-fill"></i> @L["SendMessage"]
                                </button>
                            }
                            <button class="btn @(isFavorite ? "btn-outline-danger" : "btn-outline-secondary") rounded-pill py-2 border-dashed" @onclick="ToggleFavorite">
                                <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") me-2"></i>
                                @(isFavorite? L["InFavorites"] : L["AddToFavorites"])
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h4 class="fw-bold mb-3 text-coral">@L["AboutTitle"]</h4>
                        <p class="fs-5 text-secondary">@profile.FullBio</p>
                        <hr class="my-4 opacity-10">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small d-block">@L["EducationLabel"]</label>
                                <span class="fw-bold">@profile.Education</span>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small d-block">@L["PriceLabel"]</label>
                                <span class="fw-bold text-coral fs-4">
                                    @profile.PricePerHour <i class="nbrb-icon">BYN</i> / @L["PerHour"]
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h4 class="fw-bold mb-3 text-coral">@L["ContactInfoTitle"]</h4>
                        <div class="row g-3">
                            @if (!string.IsNullOrEmpty(profile.Phone))
                            {
                                <div class="col-md-6">
                                    <label class="text-muted small d-block">@L["PhoneLabel"]</label>
                                    <a href="tel:@profile.Phone" class="fw-bold text-dark text-decoration-none">
                                        <i class="bi bi-telephone-fill me-1 text-coral"></i> @profile.Phone
                                    </a>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(profile.City))
                            {
                                <div class="col-md-6">
                                    <label class="text-muted small d-block">@L["CityLabel"]</label>
                                    <span class="fw-bold text-dark"><i class="bi bi-buildings-fill me-1 text-coral"></i> @profile.City</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (profile.IsPassportVerified)
                            {
                                <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle"></i> @L["PassportVerified"]</span>
                            }
                            @if (profile.IsEducationVerified)
                            {
                                <span class="badge bg-info-subtle text-info"><i class="bi bi-patch-check"></i> @L["EducationVerified"]</span>
                            }
                            @if (profile.IsSelfEmployed)
                            {
                                <span class="badge bg-warning-subtle text-warning"><i class="bi bi-briefcase"></i> @L["SelfEmployed"]</span>
                            }
                        </div>
    
                        @if (!string.IsNullOrEmpty(profile.SpeechDisorders))
                        {
                            <h5 class="fw-bold mb-3">@L["DisordersTitle"]</h5>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in profile.SpeechDisorders.Split(';', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge border text-dark bg-light rounded-pill px-3">@tag</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h4 class="fw-bold mb-3 text-coral">@L["ProfessionalDetails"]</h4>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted small d-block">@L["WorkType"]</label>
                                <span class="fw-bold text-dark">@profile.WorkType</span>
                            </div>
                            @if (profile.IsSelfEmployed)
                            {
                                <div class="col-md-6">
                                    <label class="text-muted small d-block">@L["Status"]</label>
                                    <span class="fw-bold text-success"><i class="bi bi-check-circle-fill"></i> @L["IsSelfEmployed"]</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(profile.SpecialNeeds))
                            {
                                <div class="col-12">
                                    <label class="text-muted small d-block">@L["SpecialNeeds"]</label>
                                    <span class="fw-bold">@profile.SpecialNeeds</span>
                                </div>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(profile.Address))
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                            <h4 class="fw-bold mb-3 text-coral">
                                <i class="bi bi-geo-alt-fill me-2"></i>@L["LocationTitle"]
                            </h4>
                            <p class="fw-semibold text-dark mb-3">
                                <span class="text-muted fw-normal">@L["OfficeAddress"]:</span> @profile.Address
                            </p>
                            <div class="map-container border rounded-4 overflow-hidden shadow-sm" style="height: 300px; width: 100%;">
                                <iframe src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(profile.Address))&t=&z=15&ie=UTF8&iwloc=&output=embed" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(profile.CertificateUrls))
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                            <h4 class="fw-bold mb-3 text-coral"><i class="bi bi-patch-check"></i> @L["CertificatesTitle"]</h4>
                            <div class="row g-3">
                                @foreach (var url in profile.CertificateUrls.Split(';', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <div class="col-6 col-md-4 col-xl-3">
                                        <a href="@url" target="_blank" class="certificate-link">
                                            <div class="certificate-card border rounded-3 overflow-hidden shadow-sm h-100">
                                                @if (url.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="pdf-placeholder d-flex flex-column align-items-center justify-content-center p-3 text-danger">
                                                        <i class="bi bi-file-earmark-pdf fs-1"></i>
                                                        <span class="small text-center mt-2 text-dark">@L["ViewPdf"]</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <img src="@url" class="img-fluid" alt="Сертификат" style="width: 100%; height: 120px; object-fit: cover;" />
                                                }
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h4 class="fw-bold mb-4 text-coral">@L["ReviewsTitle"]</h4>
                        <div class="add-review mb-5 p-4 rounded-4 shadow-sm bg-white border">
                            <h6 class="fw-bold mb-3">@L["LeaveReview"]</h6>
                            <div class="rating-picker mb-3">
                                <label class="d-block small text-muted mb-2">@L["YourRating"]:</label>
                                <div class="stars-row">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        int starIndex = i;
                                        <i class="bi @(starIndex <= (currentHover > 0 ? currentHover : newReviewRating) ? "bi-star-fill text-warning" : "bi-star text-muted") star-icon"
                                           @onclick="() => SetRating(starIndex)"
                                           @onmouseover="() => HoverRating(starIndex)"
                                           @onmouseout="() => HoverRating(0)"></i>
                                    }
                                    <span class="ms-2 fw-bold text-coral">@newReviewRating / 5</span>
                                </div>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="anonCheck" @bind="isAnonymous" />
                                <label class="form-check-label" for="anonCheck">@L["PostAnonymously"]</label>
                            </div>

                            <label class="form-label fw-bold">@L["AttachFile"]</label>
                            <div class="mb-3">
                                <InputFile OnChange="HandleFileSelected" class="form-control" accept=".jpg,.jpeg,.png,.pdf" multiple />
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @for (int i = 0; i < selectedFiles.Count; i++)
                                {
                                    if (i < previewDataUrls.Count)
                                    {
                                        var index = i;
                                        <div class="position-relative border rounded p-1" style="width: 80px; height: 80px;">
                                            @if (previewDataUrls[index] == "pdf")
                                            {
                                                <div class="d-flex align-items-center justify-content-center h-100"><i class="bi bi-file-earmark-pdf fs-2 text-danger"></i></div>
                                            }
                                            else
                                            {
                                                <img src="@previewDataUrls[index]" class="img-fluid h-100" style="object-fit: cover;" />
                                            }
                                            <button type="button" class="btn btn-sm btn-danger rounded-circle position-absolute" style="top: -10px; right: -10px; padding: 0px 6px;" @onclick="() => RemoveFile(index)"><i class="bi bi-x"></i></button>
                                        </div>
                                    }
                                }
                            </div>
                            <input type="text" class="form-control mb-3" placeholder="@L["YourNamePlaceholder"]" @bind="newReviewName" />
                            <textarea class="form-control mb-3" rows="3" placeholder="@L["YourExperiencePlaceholder"]" @bind="newReviewText"></textarea>
                            <div class="text-end">
                                <button class="btn btn-coral rounded-pill px-5 shadow-sm" @onclick="SubmitReview">@L["SubmitReview"]</button>
                            </div>
                        </div>

                        <div class="reviews-list">
                            @if (!reviews.Any())
                            {
                                <p class="text-muted text-center">@L["NoReviewsYet"]</p>
                            }
                            else
                            {
                                @foreach (var r in reviews)
                                {
                                    <div class="review-item border-bottom pb-3 mb-3">
                                        <div class="d-flex justify-content-between">
                                            <span class="fw-bold">@(r.IsAnonymous ? L["Anonymous"] : r.AuthorName)</span>
                                            <div class="text-warning">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <i class="bi @(s <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </div>
                                        </div>
                                        <p class="text-muted small mb-1">@r.CreatedAt.ToShortDateString()</p>
                                        <p class="mb-0 italic">"@r.Content"</p>
                                        @if (!string.IsNullOrEmpty(r.AttachmentUrl))
                                        {
                                            <div class="mt-2 d-flex gap-2">
                                                @foreach (var path in r.AttachmentUrl.Split(';', StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <a href="@path" target="_blank">
                                                        @if (path.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="badge bg-light text-danger border"><i class="bi bi-file-earmark-pdf"></i> PDF</span>
                                                        }
                                                        else
                                                        {
                                                            <img src="@path" class="img-thumbnail" style="max-width: 80px; height: 80px; object-fit: cover;" />
                                                        }
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .text-coral {
        color: #FF8A5B;
    }

    .btn-coral {
        background: #FF8A5B;
        color: white;
        border: none;
    }

        .btn-coral:hover {
            background: #e67a4e;
            color: white;
        }

    .italic {
        font-style: italic;
    }

    .star-icon {
        font-size: 1.5rem;
        cursor: pointer;
        margin-right: 4px;
        transition: transform 0.1s;
    }

        .star-icon:hover {
            transform: scale(1.2);
        }

    .border-dashed {
        border-style: dashed !important;
    }

    .certificate-link:hover .certificate-card {
        transform: translateY(-5px);
        transition: 0.3s;
    }

    .pdf-placeholder {
        background: #fff5f5;
        min-height: 120px;
    }
</style>

@code {
    [Parameter] public string UserId { get; set; }
    private TherapistProfile? profile;
    private List<TherapistReview> reviews = new();

    private string newReviewName = "";
    private string newReviewText = "";
    private int newReviewRating = 5;
    private int currentHover = 0;

    private bool isFavorite;
    private string? currentUserId;
    private bool isAnonymous = false; 
    private List<IBrowserFile> selectedFiles = new();
    private List<string> previewDataUrls = new();
    private string? previewUrl;
    private string? previewDataUrl;
    private Guid inputFileId = Guid.NewGuid();

    protected override async Task OnInitializedAsync()
    {
        profile = await TherapistService.GetProfileByUserId(UserId);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;

        if (profile != null)
        {
            reviews = await TherapistService.GetReviewsByTherapistIdAsync(profile.Id);

            if (!string.IsNullOrEmpty(currentUserId))
            {
                var favorites = await FavoriteService.GetUserFavoritesAsync(currentUserId);
                isFavorite = favorites.Any(f => f.TherapistProfileId == profile.Id);
            }
        }
    }

    private void SetRating(int rating) => newReviewRating = rating;
    private void HoverRating(int rating) => currentHover = rating;

    private async Task ToggleFavorite()
    {
        if (string.IsNullOrEmpty(currentUserId) || profile == null) return;

        try
        {
            await FavoriteService.ToggleFavoriteAsync(currentUserId, null, profile.Id);
            isFavorite = !isFavorite;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при обновлении избранного: {ex.Message}");
        }
    }
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(5);
        foreach (var file in files)
        {
            if (selectedFiles.Count >= 5) break;

            // Читаем поток сразу, пока ссылка валидна
            var path = await SaveAttachmentAsync(file);
            if (!string.IsNullOrEmpty(path))
            {
                uploadedPathsTemp.Add(path); // Создайте этот список в @code
                selectedFiles.Add(file);

                if (file.ContentType.Contains("image"))
                {
                    var resizedFile = await file.RequestImageFileAsync("image/png", 200, 200);
                    using var ms = new MemoryStream();
                    await resizedFile.OpenReadStream(1024 * 1024).CopyToAsync(ms);
                    var base64 = Convert.ToBase64String(ms.ToArray());
                    previewDataUrls.Add($"data:image/png;base64,{base64}");
                }
                else
                {
                    previewDataUrls.Add("pdf");
                }
            }
        }
    }

    private void RemoveFile(int index)
    {
        selectedFiles.RemoveAt(index);
        previewDataUrls.RemoveAt(index);
    }

    private List<string> uploadedPathsTemp = new(); // Список путей, сформированный при выборе

    private async Task SubmitReview()
    {
        if (string.IsNullOrWhiteSpace(newReviewText) || profile == null) return;

        var review = new TherapistReview
        {
            TherapistProfileId = profile.Id,
            AuthorName = isAnonymous ? "Аноним" : newReviewName,
            Content = newReviewText,
            Rating = newReviewRating,
            CreatedAt = DateTime.UtcNow,
            IsAnonymous = isAnonymous,
            AttachmentUrl = string.Join(";", uploadedPathsTemp) 
        };

        var result = await TherapistService.AddReviewAsync(review);
    
        if (result)
        {
            // Очистка
            uploadedPathsTemp.Clear();
            selectedFiles.Clear();
            previewDataUrls.Clear();
            newReviewText = "";
            newReviewName = ""; 
            newReviewRating = 5;
            isAnonymous = false;
            reviews = await TherapistService.GetReviewsByTherapistIdAsync(profile.Id);
            StateHasChanged();
        }
    }
    private void NavigateToChat()
    {
        NavigationManager.NavigateTo($"/chat/{UserId}");
    }

    private async Task<string> SaveAttachmentAsync(IBrowserFile file)
    {
        try
        {
            var uploadsFolder = Path.Combine(Environment.WebRootPath, "uploads", "reviews");
            if (!Directory.Exists(uploadsFolder)) Directory.CreateDirectory(uploadsFolder);
    
            var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var filePath = Path.Combine(uploadsFolder, fileName);
    
            using (var fileStream = new FileStream(filePath, FileMode.Create))
            {
                await file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5).CopyToAsync(fileStream);
            }
    
            return $"/uploads/reviews/{fileName}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при сохранении файла: {ex.Message}");
            return string.Empty;
        }
    }
}
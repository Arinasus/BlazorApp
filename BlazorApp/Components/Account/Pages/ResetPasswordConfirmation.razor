@page "/Account/ResetPasswordConfirmation"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ResetPasswordConfirmation> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="auth-main-content">
    <div class="auth-card animate-fade text-center">
        <div class="mb-4">
            <div class="display-1 text-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
        </div>

        <h2 class="auth-header">@L["Header"]</h2>
        <p class="text-muted mb-4">@L["Message"]</p>

        <a href="Account/Login" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
            @L["LoginButton"]
        </a>
    </div>
</div>
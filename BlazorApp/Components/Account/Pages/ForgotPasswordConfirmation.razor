@page "/Account/ForgotPasswordConfirmation"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ForgotPasswordConfirmation> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="auth-main-content">
    <div class="auth-card animate-fade text-center">
        <h2 class="auth-header">@L["Header"]</h2>

        <div class="my-4">
            <i class="bi bi-info-circle text-primary" style="font-size: 3rem;"></i>
        </div>

        <p class="mb-0">@L["Message"]</p>
        <div class="mt-4">
            <a href="Account/Login" class="btn btn-outline-primary rounded-pill px-4">
                @L["BackToLogin"]
            </a>
        </div>
    </div>
</div>
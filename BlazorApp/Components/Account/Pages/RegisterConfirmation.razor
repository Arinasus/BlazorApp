@page "/Account/RegisterConfirmation"

@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<RegisterConfirmation> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="auth-main-content">
    <div class="auth-card animate-fade text-center">
        <h2 class="auth-header">@L["AlmostDone"]</h2>

        <StatusMessage Message="@statusMessage" />

        @if (statusMessage is null)
        {
            <div class="my-4">
                <i class="bi bi-envelope-check" style="font-size: 3rem; color: var(--bs-primary);"></i>
            </div>
            <p>@L["EmailSentTo"] <strong>@Email</strong>.</p>
            <p class="text-muted">@L["CheckEmailInstructions"]</p>
        }
    </div>
</div>

@code {
    private string? statusMessage;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Email is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            statusMessage = L["UserNotFoundError"];
        }
    }
}
@page "/therapist/diary/add"
@using BlazorApp.Data
@using BlazorApp.Shared.DTOs
@using BlazorApp.Shared.Interfaces
@using BlazorApp.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Identity

@attribute [Authorize(Roles = "Therapist")]
@inject IDiaryService DiaryService
@inject ITherapistService TherapistService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<TherapistDiary> L
@rendermode InteractiveServer

<h3 class="text-coral fw-bold mt-5 mb-4">
    <i class="bi bi-journal-bookmark-fill me-2"></i>@L["DiaryTitle"]
</h3>

<div class="row animate-fade">
    <div class="col-lg-4 mb-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-lines-fill me-2 text-coral"></i>@L["CurrentStudent"]</h5>
            <label class="form-label text-muted">@L["SelectStudentHint"]</label>
            <select class="form-select rounded-3 shadow-sm" @onchange="OnSelectedChildChanged">
                <option value="0">@L["AllStudents"]</option>
                @foreach (var child in connectedChildren)
                {
                    <option value="@child.ChildId">@child.ChildName (@L["Parent"]: @child.ParentEmail)</option>
                }
            </select>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
            <h5 class="fw-bold text-dark mb-3">@L["NewRecord"]</h5>
            <EditForm Model="newLog" OnValidSubmit="SaveLog">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label fw-bold small">@L["ChildName"]</label>
                    <InputText @bind-Value="newLog.ChildName" class="form-control" placeholder="@L["ChildNamePlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">@L["SessionDate"]</label>
                    <InputDate @bind-Value="newLog.SessionDate" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">@L["Topic"]</label>
                    <InputText @bind-Value="newLog.Topic" class="form-control" placeholder="@L["TopicPlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">@L["WorkDone"]</label>
                    <InputTextArea @bind-Value="newLog.WorkDone" class="form-control" rows="3" placeholder="@L["WorkDonePlaceholder"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small">@L["Homework"]</label>
                    <InputTextArea @bind-Value="newLog.Homework" class="form-control" rows="2" placeholder="@L["HomeworkPlaceholder"]" />
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill btn-details fw-bold py-2">@L["BtnSave"]</button>
            </EditForm>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <h5 class="fw-bold text-dark mb-3">@L["HistoryTitle"]</h5>
        <div class="card border-0 shadow-sm rounded-4 p-4" style="min-height: 480px;">
            @if (filteredLogs == null)
            {
                <p class="text-muted">@L["Loading"]</p>
            }
            else if (!filteredLogs.Any())
            {
                <div class="text-center py-5 text-muted"><i class="bi bi-folder-x display-4"></i><p>@L["EmptyState"]</p></div>
            }
            else
            {
                <div class="timeline" style="max-height: 600px; overflow-y: auto;">
                    @foreach (var log in filteredLogs)
                    {
                        <div class="p-3 mb-3 border-start border-4 border-primary bg-white rounded-end shadow-sm">
                            <div class="d-flex justify-content-between mb-2">
                                <h6 class="fw-bold text-dark mb-0">@log.ChildName</h6>
                                <span class="badge bg-light text-secondary border rounded-pill">@log.SessionDate.ToString("dd.MM.yyyy")</span>
                            </div>
                            <p class="text-coral fw-bold mb-1">@L["TopicLabel"]: @log.Topic</p>
                            <p class="text-muted mb-1">@log.WorkDone</p>
                            @if (!string.IsNullOrEmpty(log.Homework))
                            {
                                <div class="bg-light p-2 rounded text-success mt-2">
                                    <i class="bi bi-house-door-fill me-1"></i> <strong>@L["HomeworkLabel"]:</strong> @log.Homework
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
            <h5 class="fw-bold text-dark mb-4">
                <i class="bi bi-people-fill me-2 text-coral"></i>@L["ParentsSectionTitle"]
            </h5>
            <div class="row g-4">
                <div class="col-md-5 border-end">
                    <h6 class="fw-bold text-secondary mb-2">@L["ConnectParentTitle"]</h6>
                    <p class="text-muted small">@L["ConnectParentHint"]</p>
                    <div class="d-flex gap-2 mt-3">
                        <input type="email" class="form-control" placeholder="parent@example.com" @bind="inviteEmail" />
                        <button class="btn btn-primary rounded-pill px-4 btn-details fw-bold text-nowrap" @onclick="SendParentInvite">@L["BtnSendInvite"]</button>
                    </div>
                    @if (!string.IsNullOrEmpty(inviteMessage))
                    {
                        <div class="alert alert-info mt-3 p-2 small">@inviteMessage</div>
                    }
                </div>
                <div class="col-md-7">
                    <h6 class="fw-bold text-secondary mb-3">@L["InviteStatusTitle"]</h6>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light"><tr><th>Email</th><th>@L["DateSent"]</th><th class="text-center">@L["Status"]</th></tr></thead>
                            <tbody>
                                @foreach (var invite in myInvitations)
                                {
                                    <tr>
                                        <td>@invite.ParentEmail</td>
                                        <td>@invite.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td class="text-center">
                                            @if (invite.IsAccepted)
                                            {
                                                <span class="badge bg-success-custom rounded-pill">
                                                    <i class="bi bi-check-circle-fill me-1"></i> @L["StatusAccepted"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-custom rounded-pill">
                                                    <i class="bi bi-clock-fill me-1"></i> @L["StatusPending"]
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-coral {
        color: #FF8A5B;
    }

    .bg-coral-light {
        background-color: rgba(255, 138, 91, 0.15);
    }

    .btn-details {
        background: #FF8A5B;
        border: none;
        color: white;
    }

        .btn-details:hover {
            background: #e67a4e;
        }

    .border-primary {
        border-color: #FF8A5B !important;
    }

    .bg-success-light {
        background-color: rgba(40, 167, 69, 0.15);
    }

    .bg-warning-light {
        background-color: rgba(255, 193, 7, 0.15);
    }

    .bg-warning-custom {
        background-color: #fff3cd !important; /* Мягкий желтый фон */
        color: #856404 !important; /* Темно-желтый текст для контраста */
        border: 1px solid #ffeeba !important; /* Легкая обводка */
        font-weight: 600 !important; /* Делаем текст жирнее */
        padding: 0.35rem 0.75rem !important;
    }

    .bg-success-custom {
        background-color: #d4edda !important;
        color: #155724 !important;
        font-weight: 600 !important;
        padding: 0.35rem 0.75rem !important;
    }
</style>

@code {
    private TherapyDiaryLogDto newLog = new() { SessionDate = DateTime.Today };
    private List<TherapyDiaryLogDto> allDiaryLogs = new();
    private List<TherapyDiaryLogDto> filteredLogs = new();

    private List<ChildConnectionDto> connectedChildren = new();
    private List<InvitationStatusDto> myInvitations = new();

    private TherapistProfile currentTherapist = new();
    private string? selectedChildName;
    private string inviteEmail = "";
    private string inviteMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentTherapist = await TherapistService.GetProfileByUserId(user.Id);
            if (currentTherapist != null)
            {
                newLog.TherapistProfileId = currentTherapist.Id;

                await RefreshLogs();
                await LoadConnectionsAndInvitations();
            }
        }
    }

    private async Task RefreshLogs()
    {
        allDiaryLogs = await DiaryService.GetLogsForTherapistAsync(currentTherapist.Id);
        ApplyFilter();
    }

    private async Task LoadConnectionsAndInvitations()
    {

        connectedChildren = await DiaryService.GetConnectedChildrenForTherapistAsync(currentTherapist.Id) ?? new();
        myInvitations = await DiaryService.GetInvitationsByTherapistAsync(currentTherapist.Id) ?? new();
    }

    private void OnSelectedChildChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var childId) && childId > 0)
        {
            var selectedChild = connectedChildren.FirstOrDefault(c => c.ChildId == childId);
            if (selectedChild != null)
            {
                selectedChildName = selectedChild.ChildName;

                newLog.TargetChildId = childId;
                newLog.ChildName = selectedChild.ChildName;
            }
        }
        else
        {
            selectedChildName = null;
            newLog.TargetChildId = 0;
            newLog.ChildName = string.Empty;
        }

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(selectedChildName))
        {
            filteredLogs = allDiaryLogs;
        }
        else
        {
            filteredLogs = allDiaryLogs.Where(l => l.ChildName == selectedChildName).ToList();
        }
    }

    private async Task SaveLog()
    {
        var success = await DiaryService.AddDiaryLogAsync(newLog);
        if (success)
        {
            newLog = new TherapyDiaryLogDto
            {
                TherapistProfileId = currentTherapist.Id,
                SessionDate = DateTime.Today,
                ChildName = selectedChildName ?? string.Empty
            };
            await RefreshLogs();
        }
    }

    private async Task SendParentInvite()
    {
        if (string.IsNullOrWhiteSpace(inviteEmail)) return;

        var success = await DiaryService.SendInvitationAsync(currentTherapist.Id, inviteEmail);
        if (success)
        {
            inviteMessage = "Приглашение успешно отправлено родителю!";
            inviteEmail = "";
            await LoadConnectionsAndInvitations(); 
        }
        else
        {
            inviteMessage = "Не удалось отправить запрос. Возможно, он уже существует или введен некорректный Email.";
        }
    }
}
@page "/lecture/{Id:int}"
@rendermode InteractiveServer
@using BlazorApp.Shared.Models
@using BlazorApp.Shared.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ILectureService LectureService
@inject IFavoriteService FavoriteService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4 mb-5 animate-fade">
    @if (lecture == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border" style="color: var(--primary)" role="status"></div>
            <p class="mt-2 text-muted">Загрузка материалов...</p>
        </div>
    }
    else
    {
        <button class="btn btn-link text-decoration-none p-0 mb-4 back-link" @onclick="GoBack">
            <i class="bi bi-arrow-left-circle-fill"></i> Вернуться к списку
        </button>

        <div class="row g-5">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-3" style="color: #2D3436;">@lecture.Title</h1>

                <div class="d-flex flex-wrap gap-3 mb-4 align-items-center">
                    <span class="diagnosis-badge">
                        <i class="bi bi-patch-check-fill me-1"></i> @lecture.TargetDiagnosis
                    </span>

                    <span class="lecture-number">
                        Лекция №@lecture.Id
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(lecture.VideoUrl))
                {
                    <div class="video-card shadow-md rounded-4 overflow-hidden mb-5">
                        <div class="video-container">
                            <iframe src="@GetEmbedUrl(lecture.VideoUrl)"
                                    frameborder="0"
                                    allowfullscreen>
                            </iframe>
                        </div>
                    </div>
                }

                <div class="lecture-content bg-white p-4 p-md-5 rounded-4 shadow-sm border">
                    @((MarkupString)lecture.Content)
                </div>
            </div>

            <!-- Боковая панель -->
            <div class="col-lg-4">
                <div class="card sticky-top border-0 shadow-md p-2" style="top: 100px; border-radius: 20px;">
                    @if (!string.IsNullOrEmpty(lecture.ImagePath))
                    {
                        <img src="@lecture.ImagePath" class="card-img-top rounded-4 mb-3" alt="Обложка">
                    }
                    <div class="card-body">
                        <h5 class="fw-bold" style="color: var(--primary)">Материал портала</h5>
                        <p class="text-muted small">Этот контент доступен для сохранения в ваш личный кабинет.</p>
                        <hr class="opacity-10" />

                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-favorite w-100 mb-2 @(isFavorite ? "is-active" : "")"
                                        @onclick="ToggleFavorite">
                                    <i class="bi @(isFavorite ? "bi-bookmark-star-fill" : "bi-bookmark-star") me-2"></i>
                                    @(isFavorite ? "В избранном" : "В избранное")
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <a href="Account/Login" class="btn btn-favorite w-100 mb-2 text-center d-block text-decoration-none">
                                    <i class="bi bi-bookmark-star me-2"></i> В избранное
                                </a>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Lecture? lecture;
    private bool isFavorite;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var all = await LectureService.GetAllLecturesAsync();
        lecture = all.FirstOrDefault(l => l.Id == Id);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userId = user.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;

            if (!string.IsNullOrEmpty(userId) && lecture != null)
            {
                isFavorite = await FavoriteService.IsFavoriteAsync(userId, lectureId: Id);
            }
        }
    }

    private async Task ToggleFavorite()
    {
        if (string.IsNullOrEmpty(userId)) return;

        try
        {
            await FavoriteService.ToggleFavoriteAsync(userId, lectureId: Id);
            isFavorite = !isFavorite; 
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при обновлении избранного: {ex.Message}");
        }
    }

    private void GoBack() => NavManager.NavigateTo("/lectures");

    private string GetEmbedUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        if (url.Contains("watch?v=")) return url.Replace("watch?v=", "embed/");
        if (url.Contains("youtu.be/")) return url.Replace("youtu.be/", "youtube.com/embed/");
        return url;
    }
}
@page "/become-therapist"
@rendermode InteractiveServer
@using BlazorApp.Shared.Interfaces
@using Microsoft.AspNetCore.Authorization
@using BlazorApp.Shared.DTOs
@using BlazorApp.Shared.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Hosting
@attribute [Authorize]
@inject ITherapistService TherapistService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h3 class="text-coral fw-bold mb-4 text-center">Анкета специалиста</h3>

                <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="BecomeTherapistForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger small" />

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Специализация</label>
                            <InputText @bind-Value="model.Specialization" class="form-control" placeholder="Например: Логопед-афазиолог" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Образование</label>
                            <InputTextArea @bind-Value="model.Education" class="form-control" rows="3" placeholder="Укажите ВУЗ и специальность" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Стаж (лет)</label>
                            <InputNumber @bind-Value="model.ExperienceYears" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Цена за час (₽)</label>
                            <InputNumber @bind-Value="model.PricePerHour" class="form-control" />
                        </div>

                        <div class="col-md-12 mt-4">
                            <label class="form-label fw-bold">Дипломы и сертификаты</label>
                            <div class="upload-zone border rounded-3 p-4 text-center bg-light">
                                <InputFile OnChange="HandleFileSelected" class="form-control mb-2" multiple accept=".jpg,.jpeg,.png,.pdf" />
                                <div class="form-text">Поддерживаются форматы JPG, PNG, PDF. Можно выбрать несколько.</div>
                            </div>

                            @if (uploadedFiles.Any())
                            {
                                <div class="mt-3">
                                    <h6 class="small fw-bold">Загруженные файлы:</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var file in uploadedFiles)
                                        {
                                            <div class="badge bg-white text-dark border p-2 rounded-3">
                                                <i class="bi bi-file-earmark-check text-success me-1"></i> @file.Split('_').Last()
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-12 text-center mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm" disabled="@isUploading">
                                @if (isUploading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Отправить заявку на модерацию
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterTherapistDto model { get; set; } = new();

    private List<string> uploadedFiles = new();
    private bool isUploading = false;

    protected override void OnInitialized() => model ??= new();

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        var files = e.GetMultipleFiles(5); // Лимит 5 файлов

        foreach (var file in files)
        {
            try
            {
                var fileName = $"{Guid.NewGuid()}_{file.Name}";
                var path = Path.Combine(Environment.WebRootPath, "uploads", "certs");

                if (!Directory.Exists(path))
                    Directory.CreateDirectory(path);

                var fullPath = Path.Combine(path, fileName);

                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10); // 10MB лимит
                using var fileStream = new FileStream(fullPath, FileMode.Create);
                await stream.CopyToAsync(fileStream);

                uploadedFiles.Add(fileName);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при загрузке: {ex.Message}");
            }
        }
        isUploading = false;
    }

    private async Task HandleSubmit()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (userId != null)
        {
            var profile = new TherapistProfile
            {
                UserId = userId,
                Specialization = model.Specialization,
                Education = model.Education,
                ExperienceYears = model.ExperienceYears,
                PricePerHour = model.PricePerHour,
                IsApproved = false,
                CreatedAt = DateTime.UtcNow,
                // Сохраняем пути к сертификатам через разделитель
                CertificateUrls = uploadedFiles.Any() ? string.Join(";", uploadedFiles.Select(f => $"/uploads/certs/{f}")) : null
            };

            await TherapistService.CreateApplicationAsync(profile);
            Navigation.NavigateTo("/Account/Manage");
        }
    }
}
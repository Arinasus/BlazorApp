@using Microsoft.AspNetCore.Identity
@using BlazorApp.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject AuthenticationStateProvider AuthStateProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<ManageNavMenu> L

<style>
    .nav-pills .nav-link.active {
        background-color: #FF8A5B !important;
        color: white !important;
    }

    .nav-link {
        color: #555 !important;
    }

        .nav-link:hover:not(.active) {
            color: #FF8A5B !important;
            background-color: rgba(255, 138, 91, 0.1) !important;
        }
</style>

<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <NavLink class="nav-link rounded-3" href="Account/Manage" Match="NavLinkMatch.All">
            <i class="bi bi-person me-2"></i>@L["Profile"]
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link rounded-3" href="children">
            <i class="bi bi-heart me-2"></i>@L["MyChildren"]
        </NavLink>
    </li>

    <AuthorizeView Roles="Therapist">
        <li class="nav-item">
            <NavLink class="nav-link rounded-3" href="Account/Manage/TherapistSettings">
                <i class="bi bi-journal-check me-2"></i>@L["MyProfile"]
            </NavLink>
        </li>
    </AuthorizeView>

    <li class="nav-item">
        <NavLink class="nav-link rounded-3" href="Account/Manage/Email">
            <i class="bi bi-envelope me-2"></i>@L["Email"]
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link rounded-3" href="Account/Manage/ChangePassword">
            <i class="bi bi-key me-2"></i>@L["Password"]
        </NavLink>
    </li>

    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <NavLink class="nav-link rounded-3" href="Account/Manage/ExternalLogins">
                <i class="bi bi-shield-lock me-2"></i>@L["ExternalLogins"]
            </NavLink>
        </li>
    }

    <li class="nav-item">
        <NavLink class="nav-link rounded-3" href="Account/Manage/TwoFactorAuthentication">
            <i class="bi bi-patch-check me-2"></i>@L["TwoFactorAuth"]
        </NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link rounded-3" href="Account/Manage/PersonalData">
            <i class="bi bi-database-exclamation me-2"></i>@L["PersonalData"]
        </NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;
    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
@page "/"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Home> L

<PageTitle>@L["PageTitle"]</PageTitle>

<div class="home-hero animate__animated animate__fadeIn">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">
                    @L["HeroTitle1"] <span class="text-primary">@L["HeroTitle2"]</span> @L["HeroTitle3"]
                </h1>
                <p class="lead text-muted mb-5">
                    @L["HeroSubtitle"]
                </p>
                <div class="d-flex gap-3">
                    <a href="Account/Register" class="btn btn-primary btn-lg px-5 py-3 rounded-pill">
                        @L["BtnStartFree"]
                    </a>
                    <a href="lectures" class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-pill">
                        @L["BtnLearnMore"]
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-img-wrapper">
                    <img src="/images/therapist_kids.png" alt="@L["ImgAltKids"]" class="img-fluid floating-anim" />
                </div>
            </div>
        </div>
    </div>
</div>

<section class="become-therapist-promo py-5">
    <div class="container text-center py-5">

        <AuthorizeView Roles="Therapist" Context="therapistContext">
            <Authorized>
                @* Пустой блок оставлен как в исходном коде *@
            </Authorized>
            <NotAuthorized>
                <div class="promo-card p-5 rounded-5 shadow-sm">
                    <h2 class="fw-bold mb-3">@L["PromoTitle1"] <span class="text-secondary-custom">@L["PromoTitle2"]</span>?</h2>
                    <p class="lead text-muted mb-4 mx-auto" style="max-width: 700px;">
                        @L["PromoSubtitle"]
                    </p>

                    <AuthorizeView Context="authContext">
                        <Authorized>
                            <a href="become-therapist" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                                @L["BtnBecomeExpert"]
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="Account/Login" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                                @L["BtnApply"]
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>

<section class="support-contact py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="support-box p-4">
                    <h3 class="fw-bold mb-3">@L["SupportTitle"]</h3>
                    <p class="text-muted mb-4">
                        @L["SupportSubtitle"]
                    </p>
                    <a href="support" class="btn btn-outline-primary rounded-pill px-4 py-2">
                        <i class="bi bi-chat-dots me-2"></i>@L["BtnContactUs"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
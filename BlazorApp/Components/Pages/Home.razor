@page "/"
@using BlazorApp.Client.Pages

<PageTitle>Речевик — Центр развития речи</PageTitle>

<div class="home-hero animate__animated animate__fadeIn">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">
                    Развиваем <span class="text-primary">речь</span> играя и с любовью
                </h1>
                <p class="lead text-muted mb-5">
                    Онлайн-платформа для занятий с логопедом. Индивидуальный подход,
                    профессиональные методики и видимый результат уже после первых занятий.
                </p>
                <div class="d-flex gap-3">
                    <a href="Account/Register" class="btn btn-primary btn-lg px-5 py-3 rounded-pill">
                        Начать бесплатно
                    </a>
                    <a href="lectures" class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-pill">
                        Узнать больше
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-img-wrapper">
                    <img src="/images/therapist_kids.png" alt="Дети занимаются" class="img-fluid floating-anim" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .home-hero {
        background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F4 100%);
        padding: 60px 0;
    }

    .min-vh-75 {
        min-height: 75vh;
    }

    .text-primary {
        color: #FF6B6B !important;
    }

    .btn-outline-secondary {
        border: 2px solid #6ECEDA !important;
        color: #6ECEDA !important;
        background: transparent;
    }

        .btn-outline-secondary:hover {
            background: #6ECEDA !important;
            color: white !important;
        }

    .floating-anim {
        animation: floating 3s ease-in-out infinite;
    }

    @@keyframes floating {
        0% {
            transform: translate(0, 0px);
        }

        50% {
            transform: translate(0, -15px);
        }

        100% {
            transform: translate(0, 0px);
        }
    }

    .hero-img-wrapper {
        position: relative;
    }

        .hero-img-wrapper::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(110, 206, 218, 0.1);
            border-radius: 50%;
            z-index: -1;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
</style>
@page "/"
@using BlazorApp.Client.Pages

<PageTitle>Речевик — Центр развития речи</PageTitle>

<div class="home-hero animate__animated animate__fadeIn">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-3 fw-bold mb-4">
                    Развиваем <span class="text-primary">речь</span> играя и с любовью
                </h1>
                <p class="lead text-muted mb-5">
                    Онлайн-платформа для занятий с логопедом. Индивидуальный подход,
                    профессиональные методики и видимый результат уже после первых занятий.
                </p>
                <div class="d-flex gap-3">
                    <a href="Account/Register" class="btn btn-primary btn-lg px-5 py-3 rounded-pill">
                        Начать бесплатно
                    </a>
                    <a href="lectures" class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-pill">
                        Узнать больше
                    </a>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-img-wrapper">
                    <img src="/images/therapist_kids.png" alt="Дети занимаются" class="img-fluid floating-anim" />
                </div>
            </div>
        </div>
    </div>
</div>

<section class="become-therapist-promo py-5">
    <div class="container text-center py-5">

        <AuthorizeView Roles="Therapist" Context="therapistContext">
            <Authorized>

            </Authorized>
            <NotAuthorized>
                <div class="promo-card p-5 rounded-5 shadow-sm">
                    <h2 class="fw-bold mb-3">Вы профессиональный <span class="text-secondary-custom">логопед</span>?</h2>
                    <p class="lead text-muted mb-4 mx-auto" style="max-width: 700px;">
                        Присоединяйтесь к сообществу «Речевик». Публикуйте свои лекции,
                        помогайте родителям и находите новых учеников.
                    </p>

                    <AuthorizeView Context="authContext">
                        <Authorized>
                            <a href="become-therapist" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                                Стать специалистом
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="Account/Login" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                                Подать заявку
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>